+;; Qualification candidate: expected input failures are values rather than
+;; exceptions. Preserve the same leaf bounds and polling between chunks.
+;; Pointer marshalling belongs to the checked foreign entry, not Scheme users.
+(def (gerbil-rs-encode-utf8-into/status str pointer capacity)
+  (if (and (string? str) (fixnum? capacity) (##fx>= capacity 0)
+           (##fx<= (string-length str) (##fxquotient capacity 4)))
+    (let (length (string-length str))
+      (let loop ((start 0) (written 0))
+        (if (##fx< start length)
+          (let* ((end (if (##fx< (##fx- length start) 256)
+                         length (##fx+ start 256)))
+                 (next (gerbil-rs-encode-utf8-status-chunk str pointer capacity start end written)))
+            (if (##fx< next 0) next (loop end next)))
+          written)))
+    -2))
+
+(def (gerbil-rs-encode-utf8-status-chunk str pointer capacity start end written)
+  (declare (not interrupts-enabled))
+  (gerbil-rs-encode-utf8-buffer-chunk-c str pointer capacity start end written))
+
 ;; One bulk call per bounded chunk, never one foreign call per character.
 ;; Body pointers exist only inside this synchronous, allocation-free leaf;
 ;; no pointer survives a return to Scheme or a possible GC/poll boundary.
