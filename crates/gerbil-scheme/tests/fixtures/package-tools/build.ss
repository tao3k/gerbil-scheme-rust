#!/usr/bin/env gxi
(import :std/build-script (only-in "package-clean" clean-package-modules!))
(call-with-output-file (list path: "build-owner.txt" truncate: #t)
  (lambda (port) (write (##os-getpid) port)))
(defbuild-script '("answer"))
(def package-build-main main)
(def (main . arguments)
  (let (result (apply package-build-main arguments))
    (when (equal? arguments ["compile"])
      (let* ((prefix (getenv "GERBIL_PATH"))
             (foreign (path-expand "lib/unrelated/" prefix))
             (link (path-expand "lib/package-fixture/external" prefix)))
        (create-directory* foreign)
        (call-with-output-file (list path: (path-expand "keep" foreign) truncate: #t)
          (lambda (port) (display "unrelated package" port)))
        (call-with-output-file
          (list path: (path-expand "lib/package-fixture/.owned-output" prefix) truncate: #t)
          (lambda (port) (display "hidden generated output" port)))
        (unless (file-exists? link) (create-symbolic-link "../unrelated" link))))
    (when (equal? arguments ["clean"])
      (call-with-output-file (list path: "clean-owner.txt" truncate: #t)
        (lambda (port) (write (##os-getpid) port)))
      (clean-package-modules!
        (pgetq package: (call-with-input-file "gerbil.pkg" read))
        (getenv "GERBIL_PATH")))
    result))
