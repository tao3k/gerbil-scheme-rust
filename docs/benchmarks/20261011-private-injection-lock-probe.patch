+++ b/repo/crates/gerbil-scheme-qualification/benches/utf8/scheduling/lock_profile.rs
@@ -0,0 +1,72 @@
+//! Perturbing isolated private-lock probe, never scheduler admission.
+use super::{SCENARIOS, batch_requests, latency, owner, process_usage, quantiles, texts_for_scenario};
+use std::{sync::{Arc, mpsc as std_mpsc}, thread, time::Instant};
+use tokio::sync::mpsc;
+
+unsafe extern "C" {
+    fn tokio_bridge_injection_stat(field: usize) -> u64;
+    fn clock_gettime(id: i32, out: *mut Timespec) -> i32;
+}
+#[repr(C)]
+struct Timespec { seconds: std::ffi::c_long, nanos: std::ffi::c_long }
+pub(super) fn thread_cpu_ns() -> u64 {
+    #[cfg(target_os = "macos")]
+    let id = 16;
+    #[cfg(target_os = "linux")]
+    let id = 3;
+    let mut out = Timespec { seconds: 0, nanos: 0 };
+    // SAFETY: official libc clock IDs and writable native timespec layout.
+    assert_eq!(unsafe { clock_gettime(id, &raw mut out) }, 0);
+    u64::try_from(out.seconds).unwrap() * 1_000_000_000 + u64::try_from(out.nanos).unwrap()
+}
+fn snapshot() -> [u64; 5] {
+    // SAFETY: probe exports five read-only atomic counters in the isolated Tokio.
+    std::array::from_fn(|field| unsafe { tokio_bridge_injection_stat(field) })
+}
+pub(crate) fn run() {
+    latency::contracts();
+    let workers = thread::available_parallelism().unwrap().get();
+    let callers = workers * 2;
+    let host = tokio::runtime::Builder::new_multi_thread().worker_threads(workers).build().unwrap();
+    let (send, receive) = mpsc::channel(workers);
+    let (ready, wait) = std_mpsc::channel();
+    let owner = thread::spawn(move || owner(receive, ready));
+    wait.recv().unwrap();
+    println!("TOKIO-LOCK-PROFILE-METHOD workers={workers} callers={callers} capacity={workers} owner=1 samples=20 diagnostic_only=true lock_probe=push_remote_task timestamp_scope=lock_request_to_acquire_and_acquire_to_before_unlock maxima=cumulative owner_wait=blocking_recv_wall_and_thread_cpu excludes_interbatch_wait=true parser_parallelism=false");
+    for (corpus, name) in SCENARIOS.iter().enumerate() {
+        let texts = Arc::new(texts_for_scenario(name));
+        for jobs in [1_000, 10_000, 100_000] {
+            assert_eq!(host.block_on(batch_requests(&send, &texts, corpus, 1_000, callers, false)).len(), 1_000);
+            for batch in 0..20 {
+                let before = snapshot();
+                let os = process_usage();
+                let started = Instant::now();
+                let rows = host.block_on(batch_requests(&send, &texts, corpus, jobs, callers, false));
+                let wall_ms = started.elapsed().as_secs_f64() * 1000.0;
+                let after = snapshot();
+                let end_os = process_usage();
+                assert_eq!(rows.len(), jobs);
+                let valid: Vec<_> = rows.iter().filter(|r| r[15] == 1).collect();
+                let n = after[0] - before[0];
+                assert!(n > 0);
+                let mut waits: Vec<_> = valid.iter().map(|r| r[13]).collect();
+                waits.sort_unstable();
+                let wait_wall: u64 = valid.iter().map(|r| r[13]).sum();
+                let wait_cpu: u64 = valid.iter().map(|r| r[14]).sum();
+                // CPU window includes the wall timestamp reads; exclude
+                // intervals where their overhead prevents subtraction.
+                let comparable: Vec<_> = valid.iter().filter(|r| r[13] >= r[14]).collect();
+                let off_cpu: u64 = comparable.iter().map(|r| r[13]-r[14]).sum();
+                let q = quantiles(&rows);
+                println!("TOKIO-LOCK-PROFILE corpus={name} jobs={jobs} batch={batch} requests={jobs} wall_ms={wall_ms:.6} injection_events={n} injection_wait_total_ns={} injection_hold_total_ns={} injection_wait_mean_ns={:.3} injection_hold_mean_ns={:.3} cumulative_wait_max_ns={} cumulative_hold_max_ns={} owner_receive_valid={} owner_receive_excluded={} owner_receive_wall_total_ns={wait_wall} owner_receive_cpu_total_ns={wait_cpu} owner_receive_wall_minus_cpu_comparable={} owner_receive_wall_minus_cpu_total_ns={off_cpu} owner_receive_p95_ns={} owner_receive_p99_ns={} response_p95_ns={} response_p99_ns={} process_cpu_ns={} process_peak_rss_bytes={}",
+                    after[1]-before[1], after[2]-before[2],
+                    (after[1]-before[1]) as f64/n as f64, (after[2]-before[2]) as f64/n as f64,
+                    after[3], after[4], valid.len(), rows.len()-valid.len(), comparable.len(),
+                    latency::percentile(&waits,95),latency::percentile(&waits,99), q[6],q[7],end_os[0]-os[0],end_os[1]);
+            }
+        }
+    }
+    drop(send);
+    owner.join().unwrap();
+    println!("TOKIO-LOCK-PROFILE-COMPLETE batches=420 samples_per_load=20 diagnostic_only=true optimization_admission=false");
+}
