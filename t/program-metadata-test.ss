;;; SPDX-License-Identifier: Apache-2.0 OR LGPL-2.1-or-later
(import :gerbil/compiler :gerbil-scheme-rust/scheme/program-build
        :std/encoding/json (only-in :std/list/list delete-duplicates/hash)
        (only-in :std/make pkg-config)
        (only-in :gerbil/runtime/loader add-load-path!))

(def (main output)
  (let* ((source (path-expand "t/metadata-entry.ss" (current-directory)))
         (ordinary (path-expand "ordinary" output))
         (expanded (path-expand "expanded" output))
         (explicit-empty (path-expand "explicit-empty" output))
         (native-options (path-expand "native-options" output))
         (library (path-expand "lib" output)))
    (for-each create-directory* [ordinary expanded explicit-empty native-options library])
    (add-load-path! library)
    (compile-module source [output-dir: library invoke-gsc: #f optimize: #t static: #t])
    (gerbil-rs-stage-program source ordinary)
    (gerbil-rs-stage-program source explicit-empty [])
    (gerbil-rs-stage-program source expanded '(:gerbil/compiler/base))
    ;; Standard compiler options must reach both compile-exe and its link plan.
    ;; This extends the same source case; no package or source fixture is added.
    (gerbil-rs-stage-program source native-options [] []
      gsc-options: ["-cc-options" "-DNATIVE_OPTIONS_CONTRACT=1"
                    "-ld-options" "-Lcontract-first -lcrypto"
                    "-ld-options" "-Lcontract-last -lssl"])
    (let ((read-plan (lambda (directory)
                       (parameterize ((current-json-read-options
                                         (make-JSONReadOptions object-as-hash: #t)))
                         (call-with-input-file (path-expand "program.json" directory) read-json)))))
      (def (options directory)
        (let (value (hash-ref (read-plan directory) "link_options"))
          (if (vector? value) (vector->list value) value)))
      (unless (equal? (options native-options)
                     (append
                       (filter (lambda (flag) (not (string-empty? flag)))
                         (string-split (pkg-config "openssl" "--libs" "--keep-system-libs" "zlib" "sqlite3") #\space))
                       ["-Lcontract-first" "-lcrypto" "-Lcontract-last" "-lssl"]
                       (call-with-input-file (path-expand "lib/libgerbil.ldd" (gerbil-home)) read)))
        (error "native compiler options changed order, included CC flags, or were dropped"))
      (displayln "PROGRAM-NATIVE-OPTIONS-OK source=Gerbil-gsc-options order=preserved"))
    (let* ((read-plan (lambda (directory)
                        (let (plan (parameterize ((current-json-read-options
                                                   (make-JSONReadOptions object-as-hash: #t)))
                                      (call-with-input-file (path-expand "program.json" directory) read-json)))
                          (let (modules (hash-ref plan "modules"))
                            (if (vector? modules) (vector->list modules) modules)))))
           (a (read-plan ordinary))
           (b (read-plan expanded))
           (names (map (cut hash-ref <> "module") b))
           (builtin (call-with-input-file (path-expand "program__exe.scm" expanded)
                      (lambda (port) (cadr (caddr (read port)))))))
      (def (descriptors modules)
        (map (lambda (module)
               (map (cut hash-ref module <>) '("module" "scm" "system"))) modules))
      (def (bootstrap-prefix? prefix modules)
        (if (null? prefix)
          (andmap (cut hash-ref <> "deferred" #f) modules)
          (and (pair? modules)
               (equal? (descriptors (list (car prefix)))
                       (descriptors (list (car modules))))
               (bootstrap-prefix? (cdr prefix) (cdr modules)))))
      (def (entry directory)
        (call-with-input-file (path-expand "program__exe.scm" directory)
          (lambda (port)
            (let loop ((forms []))
              (let (form (read port))
                (if (eof-object? form) (reverse forms)
                  (loop (cons form forms))))))))
      (def (empty-carriers-use-sdk-loader?)
        (let* ((hook (cadr (entry expanded)))
               (bindings (cadr hook))
               (linked (cadr (cadr (assoc 'linked bindings))))
               (empty (filter (lambda (module)
                                (= 0 (file-info-size (file-info (hash-ref module "scm")))))
                              b)))
          (and (pair? empty)
               (andmap (lambda (module) (not (assoc (hash-ref module "module") linked))) empty))))
      (unless (and (equal? (descriptors a) (descriptors (read-plan explicit-empty)))
                   (equal? (entry ordinary) (entry explicit-empty))
                   ;; Library imports must not reorder or replace bootstrap.
                   (bootstrap-prefix? a b)
                   (empty-carriers-use-sdk-loader?)
                   (< (length a) (length b))
                   (= (length names) (length (delete-duplicates/hash names)))
                   (member "gerbil/core/sugar~1" names)
                   (not (member "gerbil/core/sugar~1" (map (cut hash-ref <> "module") a)))
                   (andmap (lambda (module)
                             (and (file-exists? (hash-ref module "scm"))
                                  (if (hash-ref module "deferred" #f)
                                    (not (member (hash-ref module "module") builtin))
                                    (member (hash-ref module "module") builtin)))) b)
                   (not (member "gerbil-scheme-rust/scheme/program-metadata" names)))
        (error "metadata closure or builtin registration changed"))
      (displayln "PROGRAM-METADATA-OK ordinary=" (length a)
                 " expanded=" (length b) " duplicate-identities=0 missing-inputs=0"))))
