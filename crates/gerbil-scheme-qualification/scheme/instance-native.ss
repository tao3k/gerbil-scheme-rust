;; Actual native Scheme values, using the existing strong-root ABI.
(def instance-retained [])
(def native-before 0)
(def native-after 0)
(def (instance-native-call value)
  (if (not (s64vector? value)) (begin (##gc) value)
    (case (s64vector-ref value 0)
      ((0)
       (##gc)
       (let* ((n (s64vector-length value)) (output (make-s64vector (1- n)))
              (transform (lambda (x) (+ (* x 3) 7))))
         (let loop ((i 1))
           (unless (= i n)
             (s64vector-set! output (1- i) (transform (s64vector-ref value i)))
             (loop (1+ i))))
         output))
      ((1)
       (dynamic-wind
         (lambda () (set! native-before (1+ native-before)))
         (lambda () (make-vector 65536 value) (##gc) (error "injected Scheme task failure"))
         (lambda () (set! native-after (1+ native-after)))))
      ((2)
       (s64vector (instance-lifecycle (s64vector-ref value 1) (s64vector-ref value 2))))
      ((3)
       ;; Positive retention control: independent of the external root registry.
       (set! instance-retained (cons (make-u8vector (s64vector-ref value 1) 90) instance-retained))
       (##gc)
       (s64vector (length instance-retained)))
      ((4) (set! instance-retained []) (##gc) (s64vector 0))
      ((5) (s64vector native-before native-after))
      ((6) (instance-green-call value))
      ((7) (instance-orders-close!))
      ((8) (##gc) #f)
      ((9) (##gc) #!void)
      (else (##gc) value))))
(begin-foreign
 (c-define (owner-native-call root) (int64) int64 "gerbil_owner_native_call" "extern"
  (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call root
    gerbil-scheme-rust/qualification/actors#instance-native-call)))
