;; Cold correctness entry only. The real native/checked kernels are used directly.
(def (orders-result-construction-contract)
  (let (checks 0)
    (def (capture unit input rank worker checkpoint)
      (with-catch (lambda (exn) (cons 'failure exn))
        (lambda () (cons 'success (unit rank worker input 1 checkpoint)))))
    (def (failure-prefix exn)
      (if (eq? exn #f) 'exact-false
        (call-with-input-string
          (with-output-to-string (lambda () (display-exception exn (current-output-port))))
          (lambda (port) (list (read-line port) (read-line port))))))
    (def (compare input (rank (lambda () 1)) (worker 0))
      (let ((a (capture orders-unit/rank input rank worker #f))
            (b (capture orders-unit/native input rank worker #f)))
        (unless (eq? (car a) (car b)) (error "result construction changed outcome"))
        (if (eq? (car a) 'success)
          (unless (and (equal? (cdr a) (cdr b)) (not (eq? (cdr a) (cdr b))))
            (error "result construction changed values or freshness"))
          (unless (equal? (failure-prefix (cdr a)) (failure-prefix (cdr b)))
            (error "result construction changed checked failure")))
        (##gc) (set! checks (1+ checks))))
    (for-each (lambda (id)
      (let (input (vector-ref (actor-arrival-input id) 1))
        (compare input)
        (actor-arrival-verify! id (orders-unit/native (lambda () 1) 0 input 4 #f))))
      '(-1 0 1 15 16 127 1000000 4999999 5000000 9223372036854775807))
    ;; Valid non-fixnum totals remain supported by the original fallback.
    (let (input (vector-ref (actor-arrival-input 41) 1))
      (s64vector-set! input 3 2305843009213693952) (s64vector-set! input 4 0)
      (compare input))
    (compare (vector-ref (actor-arrival-input 42) 1) (lambda () 2305843009213693952))
    ;; Invalid source records and final signed64 overflow keep original failures.
    (for-each (lambda (field)
      (let (input (vector-ref (actor-arrival-input 43) 1))
        (s64vector-set! input (car field) (cdr field)) (compare input)))
      '((2 . 16) (3 . 0) (3 . -1)))
    (let (input (vector-ref (actor-arrival-input 44) 1))
      (s64vector-set! input 3 9223372036854775798)
      (s64vector-set! input 4 9223372036854775807) (compare input))
    (compare (vector-ref (actor-arrival-input 45) 1) (lambda () #f))
    (compare (vector-ref (actor-arrival-input 46) 1) (lambda () 1) #f)
    (compare (vector-ref (actor-arrival-input 47) 1) (lambda () (raise #f)))
    (def (rank-reentries unit)
      (let ((resume #f) (phase 0) (seen [])
            (input (vector-ref (actor-arrival-input 48) 1)))
        (let (value (unit (lambda () (##gc) (call/cc (lambda (k) (set! resume k) 1))) 0 input 4 #f))
          (unless (and (= (s64vector-ref value 3) (1+ phase)) (not (memq value seen)))
            (error "rank reentry reused result"))
          (set! seen (cons value seen))
          (if (< phase 2)
            (begin (set! phase (1+ phase)) (##gc) (resume (1+ phase)))
            (reverse seen)))))
    (unless (equal? (rank-reentries orders-unit/rank) (rank-reentries orders-unit/native))
      (error "rank continuation semantics changed"))
    (def (checkpoint-reentries unit)
      (let ((resume #f) (phase 0) (seen [])
            (input (vector-ref (actor-arrival-input 49) 1)))
        (let (value (unit (lambda () 1) 0 input 1
                      (lambda (cost more?)
                        (##gc)
                        (when (and more? (not resume))
                          (call/cc (lambda (k) (set! resume k) #t))))))
          (unless (and (= (s64vector-ref value 1) (+ 10 (* phase 9))) (not (memq value seen)))
            (error "checkpoint reentry changed mutable accumulator or result"))
          (set! seen (cons value seen))
          (if (< phase 2)
            (begin (set! phase (1+ phase)) (##gc) (resume #t))
            (reverse seen)))))
    (unless (equal? (checkpoint-reentries orders-unit/rank) (checkpoint-reentries orders-unit/native))
      (error "checkpoint continuation semantics changed"))
    (let ((token (vector 'checkpoint-failure)) (input (vector-ref (actor-arrival-input 50) 1)))
      (for-each (lambda (unit)
        (let (result (capture unit input (lambda () 1) 0 (lambda (_ __) (raise token))))
          (unless (and (eq? (car result) 'failure) (eq? (cdr result) token))
            (error "checkpoint exception identity changed"))))
        (list orders-unit/rank orders-unit/native)))
    ;; Real Scheme green suspension remains available before native construction.
    (let (input (vector-ref (actor-arrival-input 51) 1))
      (s64vector-set! input 1 1) (compare input))
    (let (input (vector-ref (actor-arrival-input 52) 1))
      (s64vector-set! input 1 2)
      (def (wait-case unit)
        (set! orders-latch-open #f)
        (let (release (spawn (lambda () (let wait () (if (positive? orders-latch-blocked) (orders-latch-release!) (begin (thread-yield!) (wait)))))))
          (let (value (unit (lambda () 1) 0 input 4 #f))
            (thread-join! release 5) value)))
      (unless (equal? (wait-case orders-unit/rank) (wait-case orders-unit/native))
        (error "green latch suspension changed"))
      (set! checks (1+ checks)))
    (s64vector 0 checks 3 3 2)))
