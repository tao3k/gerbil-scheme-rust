diff --git a/scheme/utf8.ss b/scheme/utf8.ss
index 29124aa..e88f454 100644
--- a/scheme/utf8.ss
+++ b/scheme/utf8.ss
@@ -81,20 +81,23 @@ ___U64 j = output_start;
 for (___U64 i = start; i < end; ++i) {
   const ___U32 c = source[i];
   if (c <= 0x7f) output[j++] = (___U8)c;
-  else if (c <= 0x7ff) {
-    output[j++] = (___U8)(0xc0 | (c >> 6));
-    output[j++] = (___U8)(0x80 | (c & 0x3f));
-  } else if (c <= 0xffff) {
-    if ((c >> 11) == 0x1b) return ___FIX(-1);
-    output[j++] = (___U8)(0xe0 | (c >> 12));
-    output[j++] = (___U8)(0x80 | ((c >> 6) & 0x3f));
-    output[j++] = (___U8)(0x80 | (c & 0x3f));
-  } else if (c <= 0x10ffff) {
-    output[j++] = (___U8)(0xf0 | (c >> 18));
-    output[j++] = (___U8)(0x80 | ((c >> 12) & 0x3f));
-    output[j++] = (___U8)(0x80 | ((c >> 6) & 0x3f));
-    output[j++] = (___U8)(0x80 | (c & 0x3f));
-  } else return ___FIX(-1);
+  else {
+    /* c_intf.c's UTF_8_put shares the continuation-byte suffix. Keep
+       stricter Unicode scalar admission, and never emit five/six bytes. */
+    if (c > 0x10ffff || (c >> 11) == 0x1b) return ___FIX(-1);
+    const unsigned width = 2 + (c > 0x7ff) + (c > 0xffff);
+    ___U32 remaining = c;
+    ___U64 cursor = j + width;
+    j = cursor;
+    switch (width) {
+      case 4: output[--cursor] = (___U8)(0x80 | (remaining & 0x3f)); remaining >>= 6;
+        /* fall through */
+      case 3: output[--cursor] = (___U8)(0x80 | (remaining & 0x3f)); remaining >>= 6;
+        /* fall through */
+      default: output[--cursor] = (___U8)(0x80 | (remaining & 0x3f)); remaining >>= 6;
+    }
+    output[--cursor] = (___U8)((0xff - (0xff >> width)) | remaining);
+  }
 }
 return ___FIX((___S64)j);
 }
