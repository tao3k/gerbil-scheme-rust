// Conditional feasibility and evidence gates. No value is a measured runtime cost.
module actor_service_contract {
  import actor_service_calculus.* from "./actor_service_calculus"
  // Narrow work-unit entry obligation; Actor/frame lifecycle stays canonical.
  // A cached context is observation, never current lease authority.
  type UnitEntry = { snapshotContext:bool,currentContext:bool,executing:bool,leaseHeld:bool }
  pure def unitEntrySafe(e:UnitEntry):bool = not(e.executing) or not(e.currentContext) or e.leaseHeld
  type Goal = { periodNs:int,burst:int,maxDebt:int,latencyNs:int }
  type Availability = { numerator:int,denominator:int,latencyNs:int }
  // Waiting fields exclude own business CPU; sum is conservative, never a sum of p99s.
  type Fairness = { sourceNs:int,workerNs:int,externalNs:int,readyNs:int,pauseTotalNs:int }
  type Evidence = { cost:str,availability:str,fairness:str,retirementTail:str,
                    sourceMatched:bool,readPrivateInbox:bool,rewoundCursor:bool }
  pure def valid(g:Goal,c:Cost,a:Availability,f:Fairness):bool =
    g.periodNs>0 and g.burst>0 and g.maxDebt>=g.burst and g.latencyNs>0 and validCost(c) and
    a.numerator>0 and a.denominator>=a.numerator and a.latencyNs>=0 and
    f.sourceNs>=0 and f.workerNs>=0 and f.externalNs>=0 and f.readyNs>=0 and f.pauseTotalNs>=0
  pure def effectiveCycle(c:Cost,a:Availability):int = ceilDiv(cycleCost(c)*a.denominator,a.numerator)
  pure def requestBound(c:Cost,f:Fairness):int =
    cycleCost(c)+f.sourceNs+f.workerNs+f.externalNs+f.readyNs+f.pauseTotalNs
  pure def conditionsFit(g:Goal,c:Cost,a:Availability,f:Fairness):bool =
    if(valid(g,c,a,f))
      hasRecoveryHeadroom(g.periodNs,effectiveCycle(c,a)) and
      backlogBound(g.periodNs,g.burst,effectiveCycle(c,a),a.latencyNs)<=g.maxDebt and
      requestBound(c,f)<=g.latencyNs
    else false
  pure def evidenceQualified(e:Evidence):bool =
    e.cost=="qualified-upper" and e.availability=="qualified-envelope" and
    e.fairness=="qualified-progress" and e.retirementTail=="included" and
    e.sourceMatched and not(e.readPrivateInbox) and not(e.rewoundCursor)
  // Evidence labels are external obligations, never generated by a passing model.
  pure def claimSupported(g:Goal,c:Cost,a:Availability,f:Fairness,e:Evidence):bool =
    conditionsFit(g,c,a,f) and evidenceQualified(e)
  // Research retention and native admission are separate decisions. Qualification
  // of relativeEffect is an external measurement obligation, never inferred
  // from the sign of one pair, a chosen percent tolerance, or this model.
  type ResearchDecision = { hardFailure:bool,relativeEffect:str,absolutePassed:bool }
  pure def researchDisposition(d:ResearchDecision):str =
    if(d.hardFailure or d.relativeEffect=="qualified-regression") "withdraw"
    else if(Set("unconfirmed","qualified-gain").contains(d.relativeEffect)) "retain-isolated"
    else "invalid-evidence"
  // Eligibility to seek review, NOT an automatic performance certificate.
  // Existing claimSupported and the actual unchanged runtime gates still apply.
  pure def maySeekAdmissionReview(d:ResearchDecision):bool =
    researchDisposition(d)=="retain-isolated" and d.relativeEffect=="qualified-gain" and d.absolutePassed
  // Right-censored planned population, after every planned arrival is due.
  // Use timed samples, NOT retired frames: their counts may differ at failure.
  // Zero is an uninformative mathematical bound, never an observed p99.
  pure def missingQuantileLowerBound(total:int,samples:int,youngestAge:int,allDue:bool,num:int,den:int):int =
    if(total>0 and 0<=samples and samples<=total and youngestAge>=0 and allDue and 0<num and num<=den)
      if(total-samples>total-rank(total,num,den)) youngestAge else 0
    else 0
  pure def maxServiceLatencyForDebt(g:Goal,cycleNs:int):int = (g.maxDebt-g.burst)*g.periodNs-cycleNs
  pure def readyRepliesAhead(frames:int):int = frames-1
  // Requires eligible work and a bounded NEXT opportunity, not weak fairness alone.
  pure def eligibleWaitBound(ahead:int,opportunityGapNs:int):int = (ahead+1)*opportunityGapNs
  pure def noConsumptionGapFits(g:Goal,startNs:int,gapNs:int,alreadyConsumed:int,total:int):bool =
    arrivals(startNs+gapNs,g.periodNs,g.burst,total)-alreadyConsumed<=g.maxDebt
  // An owner task includes native execution, cold report projection and reply
  // publication. A ticket timeout alone cannot locate the native wait stage.
  pure def ownerCompletionStage(nativeReturned:bool,reportReturned:bool,replyPublished:bool):str =
    if((reportReturned and not(nativeReturned)) or (replyPublished and not(reportReturned))) "invalid"
    else if(replyPublished) "completed"
    else if(reportReturned) "reply-publication"
    else if(nativeReturned) "report-projection"
    else "native-call-unattributed"
  pure def wholeOwnerTaskFits(nativeNs:int,reportNs:int,publishNs:int,goalNs:int):bool =
    nativeNs>=0 and reportNs>=0 and publishNs>=0 and goalNs>=0 and
    nativeNs+reportNs+publishNs<=goalNs
  // Generated-code host reentry can charge module-wide setup even when all
  // source-level observation hooks are erased. Entries/time require native
  // evidence; the number of FFI calls is NOT a measured entry count.
  pure def cycleWithHostReentry(baseNs:int,entries:int,entryNs:int):int =
    if(baseNs>=0 and entries>=0 and entryNs>=0) baseNs+entries*entryNs else -1
  // SDK compiler-specific policy may be overridden, but source parity and
  // semantic checks alone cannot admit the override as a performance baseline.
  pure def hostOverrideQualified(overridden:bool,semanticsChecked:bool,costChecked:bool):bool =
    not(overridden) or (semanticsChecked and costChecked)
}
