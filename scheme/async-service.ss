;;; Scheme owns tasks, continuations, native waits and wake delivery.
(import :gerbil-scheme-rust/scheme/service-budget
        (only-in "runtime" gerbil-rs-exception-message
          gerbil-rs-result-batch-pending gerbil-rs-clear-result-batch!))
(export make-gerbil-rs-service gerbil-rs-service-submit! gerbil-rs-service-ready!
        gerbil-rs-service-take! gerbil-rs-service-wait! gerbil-rs-service-stop! gerbil-rs-service-close! make-gerbil-rs-service-endpoint)

(defstruct service-job (id input value failure failed done lane short progress claimed-epoch))
(defstruct scheme-service (handler limit jobs next workers idle queued ready short-queued short-ready short-count turns lock event port output watcher wake broken closing budget direct notified write-fd progress completion-mode completion-epoch completion-due completion-token completion-claimed completion-batches completion-items completion-batch))

;; Completion queues have amortized constant-time push/pop. A bounded host
;; turn must not repeatedly reverse every remaining completion under pressure.
(include "service-port-wake.ss")

(defstruct service-fifo (front back))
(def (service-fifo-empty? queue)
  (and (null? (service-fifo-front queue)) (null? (service-fifo-back queue))))
(def (service-fifo-push! queue value)
  (set! (service-fifo-back queue) (cons value (service-fifo-back queue))))
(def (service-fifo-pop! queue)
  (when (null? (service-fifo-front queue))
    (set! (service-fifo-front queue) (reverse (service-fifo-back queue)))
    (set! (service-fifo-back queue) []))
  (let (front (service-fifo-front queue))
    (and (pair? front) (begin (set! (service-fifo-front queue) (cdr front)) (car front)))))
(def (service-fifo-drain! queue)
  (let (values (append (service-fifo-front queue) (reverse (service-fifo-back queue))))
    (set! (service-fifo-front queue) []) (set! (service-fifo-back queue) []) values))

(def (service-locked service thunk)
  (dynamic-wind
    (lambda () (mutex-lock! (scheme-service-lock service)))
    thunk
    (lambda () (mutex-unlock! (scheme-service-lock service)))))
(def (service-signal! service)
  (condition-variable-broadcast! (scheme-service-event service)))
;; Separate queues, one short turn followed by an eligible general turn.
;; Affine jobs are never reassigned; active Scheme computations are not cancelled.
(def (service-pop! service worker short?)
  (let loop ((queued (if short? (scheme-service-short-queued service) (scheme-service-queued service))) (prefix []))
    (cond
      ((null? queued) #f)
      ((or (= (service-job-lane (car queued)) -1) (= (service-job-lane (car queued)) worker))
       (let (remaining (append (reverse prefix) (cdr queued)))
         (if short?
           (set! (scheme-service-short-queued service) remaining)
           (set! (scheme-service-queued service) remaining)))
       (car queued))
      (else (loop (cdr queued) (cons (car queued) prefix))))))
(def (service-next! service worker)
  (let* ((short-first? (not (vector-ref (scheme-service-turns service) worker)))
         (job (or (service-pop! service worker short-first?)
                  (service-pop! service worker (not short-first?)))))
    (if job
      (begin (vector-set! (scheme-service-turns service) worker (service-job-short job)) job)
      (begin (set! (scheme-service-idle service) (cons worker (scheme-service-idle service))) #f))))
(def (service-finished! service job)
  (gerbil-rs-progress-finish! (service-job-progress job))
  (set! (service-job-input job) #f)
  (set! (service-job-done job) #t)
  (if (service-job-short job)
    (service-fifo-push! (scheme-service-short-ready service) (service-job-id job))
    (service-fifo-push! (scheme-service-ready service) (service-job-id job)))
  (service-signal! service)
  (when (scheme-service-direct service) (service-port-notify! service)))
(def (service-eligible? queued worker)
  (and (pair? queued)
       (or (= (service-job-lane (car queued)) -1)
           (= (service-job-lane (car queued)) worker)
           (service-eligible? (cdr queued) worker))))
(def (service-handoff! service worker job)
  (let* ((mode (scheme-service-completion-mode service))
         (handoff?
          (service-locked service
            (lambda ()
              (let (new-opportunity? (and (>= mode 2)
                      (or (not (scheme-service-completion-due service))
                          (and (service-job-short job)
                               (service-fifo-empty? (scheme-service-short-ready service))))))
                (when new-opportunity?
                  (when (>= (scheme-service-completion-epoch service) 9223372036854775807)
                    (error "completion epoch exhausted"))
                  (set! (scheme-service-completion-epoch service)
                    (1+ (scheme-service-completion-epoch service))))
                (when (>= mode 2) (set! (scheme-service-completion-due service) #t))
                (service-finished! service job)
                (if (and (or (= mode 1) new-opportunity?)
                         (or (service-eligible? (scheme-service-short-queued service) worker)
                             (service-eligible? (scheme-service-queued service) worker)))
                  #t
                  ;; No explicit handoff: normal Scheme selection/idle receive.
                  ;; A pending epoch coalesces further bulk completions.
                  (service-next! service worker)))))))
    (if (eq? handoff? #t)
      (begin (thread-yield!)
        (service-locked service (lambda () (service-next! service worker))))
      handoff?)))
(def (service-worker service worker)
  (let receive ()
    (let (message (thread-receive))
      (unless (eq? message 'stop)
        (let process ((job message))
          (with-catch
            (lambda (failure) (set! (service-job-failed job) #t) (set! (service-job-failure job) failure))
            (lambda ()
              (set! (service-job-value job)
                (call-with-gerbil-rs-budget-context (scheme-service-budget service) (service-job-short job)
                  (lambda () (parameterize ((gerbil-rs-progress-context (service-job-progress job)))
                    ((scheme-service-handler service) worker (service-job-input job))))))))
          (let (next (service-handoff! service worker job))
            (if next
              (begin
                (when (and (not (positive? (scheme-service-completion-mode service)))
                           (or (service-job-short job) (service-job-short next))) (thread-yield!))
                (process next))
              (receive))))))))
(def (service-watch service)
  (with-catch
    (lambda (_)
      (service-locked service
        (lambda ()
          (unless (scheme-service-closing service)
            (set! (scheme-service-broken service) #t))
          (set! (scheme-service-wake service) #t)
          (service-signal! service))))
    (lambda ()
      (let loop ()
        (let (byte (read-u8 (scheme-service-port service)))
          (service-locked service
            (lambda ()
              (set! (scheme-service-wake service) #t)
              (when (and (eof-object? byte) (not (scheme-service-closing service)))
                (set! (scheme-service-broken service) #t))
              (service-signal! service)))
          (unless (or (eof-object? byte) (scheme-service-closing service) (scheme-service-direct service)) (loop)))))))
(def (make-gerbil-rs-service handler count limit fd write-fd)
  (unless (and (procedure? handler) (integer? count) (<= 1 count 64)
               (integer? limit) (<= count limit 65536) (integer? fd) (>= fd 3) (integer? write-fd) (>= write-fd 3))
    (error "invalid Scheme service bounds"))
  (let* ((port (open-input-file (string-append "/dev/fd/" (number->string fd))))
         (output (with-catch (lambda (failure) (close-input-port port) (raise failure))
                   (lambda () (open-output-file (string-append "/dev/fd/" (number->string write-fd))))))
         (service (make-scheme-service handler limit (make-table test: eqv?) 1
                    (make-vector count) [] [] (make-service-fifo [] []) [] (make-service-fifo [] []) 0 (make-vector count #f) (make-mutex)
                    (make-condition-variable) port output #f #f #f #f (make-gerbil-rs-budget) #f #f write-fd #f 0 0 #f -1 0 0 0 #f)))
    ;; Construction failure joins already-created children before propagating.
    (with-catch
      (lambda (failure)
        (vector-for-each
          (lambda (worker) (when (thread? worker) (thread-send worker 'stop)))
          (scheme-service-workers service))
        (vector-for-each
          (lambda (worker) (when (thread? worker) (thread-join! worker)))
          (scheme-service-workers service))
        (close-input-port port)
        (close-output-port output)
        (raise failure))
      (lambda ()
        (let loop ((worker 0))
          (when (< worker count)
            (vector-set! (scheme-service-workers service) worker
              (spawn (lambda () (service-worker service worker))))
            (set! (scheme-service-idle service)
              (cons worker (scheme-service-idle service)))
            (loop (1+ worker))))
        (set! (scheme-service-watcher service) (spawn (lambda () (service-watch service))))
        service))))
(def (gerbil-rs-service-submit! service input lane (short? #f) (units 1))
  (service-locked service
    (lambda ()
      (when (or (scheme-service-closing service) (scheme-service-broken service))
        (error "Scheme service closed"))
      (unless (and (integer? lane) (<= -1 lane) (< lane (vector-length (scheme-service-workers service))))
        (error "invalid Scheme service lane"))
      (when (and short? (not (= lane -1))) (error "short service cannot move an affine Actor"))
      (when (>= (+ (table-length (scheme-service-jobs service))
                 (gerbil-rs-result-batch-pending (scheme-service-completion-batch service)))
              (scheme-service-limit service))
        (error "Scheme service capacity"))
      (let* ((id (scheme-service-next service)) (job (make-service-job id input #f #f #f #f lane short?
                 (and (scheme-service-progress service)
                      (make-gerbil-rs-progress (scheme-service-progress service) short? units)) -1))
             (idle (scheme-service-idle service))
             (target (if (= lane -1) (and (pair? idle) (car idle)) (and (memv lane idle) lane))))
        (when (>= id 9223372036854775807) (error "Scheme service identity exhausted"))
        (set! (scheme-service-next service) (1+ id))
        (table-set! (scheme-service-jobs service) id job)
        (when short? (set! (scheme-service-short-count service) (1+ (scheme-service-short-count service))))
        (if target
          (begin
            (set! (scheme-service-idle service) (filter (lambda (worker) (not (= worker target))) idle))
            (vector-set! (scheme-service-turns service) target short?)
            (thread-send (vector-ref (scheme-service-workers service) target) job))
          (if short?
            (set! (scheme-service-short-queued service) (append (scheme-service-short-queued service) (list job)))
            (set! (scheme-service-queued service) (append (scheme-service-queued service) (list job)))))
        id))))
(def (service-ready-ids! service)
  (unless (and (positive? (scheme-service-completion-mode service))
               (or (not (service-fifo-empty? (scheme-service-ready service)))
                   (not (service-fifo-empty? (scheme-service-short-ready service)))))
    (thread-yield!))
  (service-locked service
    (lambda ()
      (when (and (>= (scheme-service-completion-mode service) 2)
                 (not (= (scheme-service-completion-token service) -1)))
        (error "completion token still owned"))
      (let* ((short (service-fifo-pop! (scheme-service-short-ready service)))
             (bulk (if (or (>= (scheme-service-completion-mode service) 2)
                           (and (zero? (scheme-service-completion-mode service))
                                (zero? (scheme-service-short-count service))))
                     (service-fifo-drain! (scheme-service-ready service))
                     (let (id (service-fifo-pop! (scheme-service-ready service)))
                       (if id (list id) []))))
             (ids (append (if short (list short) []) bulk)))
        (when (and (>= (scheme-service-completion-mode service) 2)
                   (scheme-service-completion-due service))
          (unless (pair? ids) (error "completion opportunity has no ready graph"))
          (set! (scheme-service-completion-batches service) (1+ (scheme-service-completion-batches service)))
          (set! (scheme-service-completion-items service) (+ (scheme-service-completion-items service) (length ids)))
          (set! (scheme-service-completion-token service) (scheme-service-completion-epoch service))
          (for-each
            (lambda (id)
              (let (job (table-ref (scheme-service-jobs service) id #f))
                (unless (and job (service-job-done job) (= (service-job-claimed-epoch job) -1))
                  (error "invalid ready graph custody"))
                (set! (service-job-claimed-epoch job) (scheme-service-completion-token service)))) ids)
          (set! (scheme-service-completion-claimed service) (length ids)))
        (list->s64vector ids)))))
(def (gerbil-rs-service-ready! service)
  (let* ((ids (service-ready-ids! service)) (totals (scheme-service-progress service))
         (receipt (if totals (gerbil-rs-progress-receipt totals ids) ids)))
    (if (and (>= (scheme-service-completion-mode service) 2)
             (not (= (scheme-service-completion-token service) -1)))
      (list->s64vector (append (list -8 (scheme-service-completion-token service)) (s64vector->list receipt)))
      receipt)))
(def (service-completion-ack! service epoch)
  (service-locked service
    (lambda ()
      (unless (and (>= (scheme-service-completion-mode service) 2)
                   (integer? epoch) (>= epoch 0)) (error "invalid completion acknowledgement"))
      (if (not (= epoch (scheme-service-completion-token service)))
        0
        (begin
          (unless (and (zero? (scheme-service-completion-claimed service))
                       (zero? (gerbil-rs-result-batch-pending (scheme-service-completion-batch service))))
            (error "completion graphs still claimed"))
          (set! (scheme-service-completion-batch service) #f)
          (set! (scheme-service-completion-token service) -1)
          (if (= epoch (scheme-service-completion-epoch service))
            (if (and (service-fifo-empty? (scheme-service-ready service))
                     (service-fifo-empty? (scheme-service-short-ready service)))
              (begin (set! (scheme-service-completion-due service) #f) 1)
              ;; A bounded short harvest can leave ready work in this epoch.
              ;; Carry it forward so a duplicate ack cannot consume a new token.
              (begin
                (when (>= epoch 9223372036854775807) (error "completion epoch exhausted"))
                (set! (scheme-service-completion-epoch service) (1+ epoch))
                0))
            0))))))
(def (gerbil-rs-service-take! service id)
  (let (job
        (service-locked service
          (lambda ()
            (let (job (table-ref (scheme-service-jobs service) id #f))
              (unless (and job (service-job-done job)) (error "Scheme service result not ready"))
              (when (>= (scheme-service-completion-mode service) 2)
                (unless (and (>= (scheme-service-completion-token service) 0)
                             (positive? (scheme-service-completion-claimed service))
                             (= (service-job-claimed-epoch job) (scheme-service-completion-token service)))
                  (error "result has no owner completion token"))
                (set! (service-job-claimed-epoch job) -1)
                (set! (scheme-service-completion-claimed service) (1- (scheme-service-completion-claimed service))))
              (table-set! (scheme-service-jobs service) id)
              (when (service-job-short job)
                (set! (scheme-service-short-count service) (1- (scheme-service-short-count service))))
              job))))
    ;; A yielded worker may still hold the consumed job record. Detach payloads
    ;; here so that record cannot retain a result after its root/slot retires.
    (let ((value (service-job-value job)) (failure (service-job-failure job)))
      (set! (service-job-value job) #f)
      (set! (service-job-failure job) #f)
      (if (service-job-failed job) (raise failure) value))))
(def (service-result-batch! service)
  (let* ((receipt (gerbil-rs-service-ready! service))
         (start (if (and (> (s64vector-length receipt) 0) (= (s64vector-ref receipt 0) -8)) 2 0))
         (offset (if (and (< start (s64vector-length receipt)) (= (s64vector-ref receipt start) -6)) (+ start 3) start))
         (count (- (s64vector-length receipt) offset)) (statuses (make-s64vector count 0))
         (slots (and (positive? count) (make-vector count #f))))
    (let loop ((index 0))
      (when (< index count)
        (let (value (with-catch
                      (lambda (failure) (s64vector-set! statuses index 1) (gerbil-rs-exception-message failure))
                      (lambda () (gerbil-rs-service-take! service (s64vector-ref receipt (+ offset index))))))
          (vector-set! slots index (vector #t value)))
        (loop (1+ index))))
    (let (batch (and slots (vector count slots)))
      (set! (scheme-service-completion-batch service) batch)
      (vector receipt statuses batch))))
(def (gerbil-rs-service-wait! service microseconds)
  (if (scheme-service-direct service) (service-port-wait! service microseconds)
      (service-condition-wait! service microseconds)))
(def (service-condition-wait! service microseconds)
  (let ((lock (scheme-service-lock service)) (event (scheme-service-event service)))
    (mutex-lock! lock)
    (let loop ()
      (cond
        ((scheme-service-broken service)
         (mutex-unlock! lock) (error "Scheme service wake port failed"))
        ((or (not (service-fifo-empty? (scheme-service-ready service))) (not (service-fifo-empty? (scheme-service-short-ready service))) (scheme-service-wake service))
         (set! (scheme-service-wake service) #f) (mutex-unlock! lock) 0)
        (else
         ;; Only an actual host admission deadline supplies a timeout. Scheme's
         ;; native scheduler owns all Actor timers and the wake port wait.
         (let (signaled (if (positive? microseconds)
                         (mutex-unlock! lock event (/ microseconds 1000000.0))
                         (mutex-unlock! lock event)))
           (mutex-lock! lock)
           (if (and (positive? microseconds) (not signaled))
             (begin (mutex-unlock! lock) 0)
             (loop))))))))
(def (gerbil-rs-service-stop! service)
  (service-locked service
    (lambda () (set! (scheme-service-closing service) #t) (service-signal! service)))
  0)
(def (gerbil-rs-service-close! service)
  (let ((lock (scheme-service-lock service)) (event (scheme-service-event service)))
    (mutex-lock! lock)
    (set! (scheme-service-closing service) #t)
    (let drain ()
      (if (ormap (lambda (entry) (not (service-job-done (cdr entry))))
            (table->list (scheme-service-jobs service)))
        (begin (mutex-unlock! lock event) (mutex-lock! lock) (drain))
        (begin
          (for-each (lambda (entry) (table-set! (scheme-service-jobs service) (car entry)))
            (table->list (scheme-service-jobs service)))
          (service-fifo-drain! (scheme-service-ready service))
          (service-fifo-drain! (scheme-service-short-ready service))
          (set! (scheme-service-short-queued service) [])
          (set! (scheme-service-short-count service) 0)
          (gerbil-rs-clear-result-batch! (scheme-service-completion-batch service))
          (set! (scheme-service-completion-batch service) #f)
          (set! (scheme-service-completion-claimed service) 0)
          (set! (scheme-service-completion-token service) -1)
          (set! (scheme-service-completion-due service) #f)
          (mutex-unlock! lock))))
    (vector-for-each (lambda (worker) (thread-send worker 'stop)) (scheme-service-workers service))
    (vector-for-each thread-join! (scheme-service-workers service))
    (unless (gerbil-rs-budget-idle? (scheme-service-budget service))
      (error "cooperative unit resources did not drain"))
    (when (scheme-service-watcher service)
      (write-u8 0 (scheme-service-output service))
      (force-output (scheme-service-output service))
      (thread-join! (scheme-service-watcher service)))
    (close-input-port (scheme-service-port service))
    (close-output-port (scheme-service-output service))
    (set! (scheme-service-workers service) #())
    (set! (scheme-service-watcher service) #f)
    0))

;; Rooted unary command protocol: [s64 header, optional native payload].
;; 0=open(read-fd,write-fd,limit), 1=submit(lane, optional short-class=1), 2=take(id), 3=ready,
;; 4=wait(host-deadline-microseconds or zero), 7=prepare-close, 5=drain/close.
;; ABI v9 adds 16=batched native result transfer; slots retire independently.
;; ABI v8 adds coalesced completion epochs/claims and 14=acknowledge.
;; ABI v7 adds 13=idle completion handoff configuration (default zero).
;; ABI v6 adds optional declared units, progress receipts and 12=idle progress configuration.
;; ABI v5 adds 11=read actual cooperative budget and native wake mode.
;; ABI v3 adds 8=configure cooperative units (zero disables), 9=unit counters.
;; Hooks remain Scheme-owned; open/close track partially allocated app resources.
(def (make-gerbil-rs-service-endpoint handler workers on-open on-prepare on-close (native-entry? #f))
  (let ((service #f) (opened #f) (preparing #f))
    (def (prepare!)
      (unless preparing
        (when opened (on-prepare))
        (when service (gerbil-rs-service-stop! service))
        (set! preparing #t)))
    (lambda (command)
      (unless (and (vector? command) (<= 1 (vector-length command) 2)
                   (s64vector? (vector-ref command 0))
                   (positive? (s64vector-length (vector-ref command 0))))
        (error "invalid Scheme service command"))
      (let* ((header (vector-ref command 0)) (op (s64vector-ref header 0)))
        (case op
          ((0)
           (when opened (error "Scheme service already opened"))
           (set! opened #t) (set! preparing #f)
           (on-open)
           (set! service (make-gerbil-rs-service handler workers (s64vector-ref header 3)
                          (s64vector-ref header 1) (s64vector-ref header 2)))
           (s64vector 0 12 workers (s64vector-ref header 3)))
          ((1)
           (unless service (error "Scheme service not open"))
           (unless (or (= (s64vector-length header) 2)
                       (and (= (s64vector-length header) 3) (= (s64vector-ref header 2) 1))
                       (and (= (s64vector-length header) 4)
                            (<= 0 (s64vector-ref header 2) 1) (positive? (s64vector-ref header 3))))
             (error "invalid Scheme service submit class/progress"))
           (s64vector (gerbil-rs-service-submit! service (vector-ref command 1) (s64vector-ref header 1)
                        (and (>= (s64vector-length header) 3) (= (s64vector-ref header 2) 1))
                        (if (= (s64vector-length header) 4) (s64vector-ref header 3) 1))))
          ((19)
           (unless (and native-entry? service (not preparing) (= (s64vector-length header) 1)
                        (= (scheme-service-completion-mode service) 5)
                        (zero? (table-length (scheme-service-jobs service)))
                        (zero? (gerbil-rs-result-batch-pending (scheme-service-completion-batch service)))
                        (= (scheme-service-completion-token service) -1)
                        (not (scheme-service-completion-due service)))
             (error "native entry requires idle PipelineCycle"))
           (lambda (input lane short? units)
             (unless (and service (not preparing)) (error "native service entry closed"))
             (s64vector (gerbil-rs-service-submit! service input lane short? units))))
          ((13)
           (unless (and service (= (s64vector-length header) 2) (not preparing)
                        (memv (s64vector-ref header 1) '(0 1 2 3 4 5))
                        (and (zero? (table-length (scheme-service-jobs service)))
                             (zero? (gerbil-rs-result-batch-pending (scheme-service-completion-batch service))))
                        (gerbil-rs-budget-idle? (scheme-service-budget service)))
             (error "completion policy requires idle service"))
           (unless (and (= (scheme-service-completion-token service) -1)
                        (not (scheme-service-completion-due service)))
             (error "completion opportunity still owned"))
           (set! (scheme-service-completion-mode service) (s64vector-ref header 1))
           (s64vector (scheme-service-completion-mode service)))
          ((14)
           (unless (and service (= (s64vector-length header) 2))
             (error "invalid completion acknowledgement header"))
           (s64vector (service-completion-ack! service (s64vector-ref header 1))))
          ((12)
           (unless (and service (= (s64vector-length header) 2) (not preparing)
                        (= (s64vector-ref header 1) 1)
                        (and (zero? (table-length (scheme-service-jobs service)))
                             (zero? (gerbil-rs-result-batch-pending (scheme-service-completion-batch service)))))
             (error "progress configuration requires an idle service"))
           (unless (scheme-service-progress service)
             (set! (scheme-service-progress service) (make-gerbil-rs-progress-ledger)))
           (s64vector 0 (s64vector-ref header 1)))
          ((2) (gerbil-rs-service-take! service (s64vector-ref header 1)))
          ((3)
           (unless (memv (s64vector-length header) '(1 2)) (error "invalid ready header"))
           (when (= (s64vector-length header) 2)
             (service-completion-ack! service (s64vector-ref header 1)))
           (gerbil-rs-service-ready! service))
          ((16)
           (unless (and service (>= (scheme-service-completion-mode service) 3)
                        (memv (s64vector-length header) '(1 2)))
             (error "invalid native service cycle"))
           (when (= (s64vector-length header) 2)
             (service-completion-ack! service (s64vector-ref header 1)))
           (service-result-batch! service))
          ((15)
           (unless (and service (= (s64vector-length header) 1)) (error "invalid completion query"))
           (service-locked service (lambda ()
           (s64vector (scheme-service-completion-mode service)
             (scheme-service-completion-epoch service) (scheme-service-completion-token service)
             (+ (scheme-service-completion-claimed service)
                (gerbil-rs-result-batch-pending (scheme-service-completion-batch service)))
             (if (scheme-service-completion-due service) 1 0)
             (scheme-service-completion-batches service) (scheme-service-completion-items service)
             (+ (length (service-fifo-front (scheme-service-ready service)))
                (length (service-fifo-back (scheme-service-ready service)))
                (length (service-fifo-front (scheme-service-short-ready service)))
                (length (service-fifo-back (scheme-service-short-ready service))))))))
          ((4) (s64vector (gerbil-rs-service-wait! service (s64vector-ref header 1))))
          ((10)
           (unless (and service (= (s64vector-length header) 2)) (error "invalid native wake configuration"))
           (s64vector (service-port-mode! service (s64vector-ref header 1))))
          ((11)
           (unless (and service (= (s64vector-length header) 1)) (error "invalid service settings query"))
           (service-locked service
             (lambda () (s64vector (gerbil-rs-budget-limit (scheme-service-budget service))
                           (if (scheme-service-direct service) 1 0)))))
          ((8)
           (unless (and service (= (s64vector-length header) 2) (not preparing))
             (error "invalid cooperative scheduling configuration"))
           (service-locked service
             (lambda ()
               (unless (and (zero? (table-length (scheme-service-jobs service)))
                             (zero? (gerbil-rs-result-batch-pending (scheme-service-completion-batch service))))
                 (error "Scheme service must be idle to configure scheduling"))
               (gerbil-rs-budget-configure! (scheme-service-budget service) (s64vector-ref header 1))))
           (s64vector 0))
          ((9)
           (unless service (error "Scheme service not open"))
           (gerbil-rs-budget-snapshot (scheme-service-budget service)))
          ((7) (prepare!) (s64vector 0))
          ((5)
           (prepare!)
           (when service (gerbil-rs-service-close! service) (set! service #f))
           (when opened (on-close) (set! opened #f))
           (s64vector 0))
          (else (error "unknown Scheme service command")))))))
