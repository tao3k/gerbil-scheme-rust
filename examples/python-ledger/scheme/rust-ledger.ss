;;; Maintainer-side typed function DSL; the installed result executes in Rust.
(import :std/encoding/json)
(def (node kind . fields)
  (list->hash-table (cons (cons "kind" kind) fields)))
(def (name value) (node "name" (cons "value" value)))
(def (method receiver operation . arguments)
  (node "method" (cons "receiver" receiver) (cons "method" operation)
        (cons "arguments" (list->vector arguments))))
(def (main . _)
  (write-json (current-output-port)
    (hash ("schema" "gerbil-scheme-rust.rust-function-ir.v1")
          ("name" "sum_entries")
          ("parameters" (vector (hash ("name" "entries") ("ty" "&[BigInt]"))))
          ("result" "BigInt")
          ("body" (hash ("bindings" #())
            ("result" (node "fold"
              (cons "iterator" (method (name "entries") "iter"))
              (cons "accumulator" "total") (cons "item" "entry")
              (cons "initial" (node "call" (cons "callee" (name "BigInt::default"))
                                                   (cons "arguments" #())))
              (cons "step" (method (name "total") "add" (name "entry"))))))))))
