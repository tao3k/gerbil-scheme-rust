;; Selected diagnostic only. Native tables remain native values across the ABI.
(def (owner-scope-report generation)
  (let (result (make-table test: equal?))
    (table-set! result "generation" (owner-scope-control "generation" generation 0))
    (table-set! result "source-epoch" (owner-scope-control "source-epoch" generation 0))
    (table-set! result "complete" (owner-scope-control "complete" generation 0))
    (table-set! result "aborted" (owner-scope-control "aborted" generation 0))
    (table-set! result "invalid" (owner-scope-control "invalid" generation 0))
    (table-set! result "error" (owner-scope-control "error" generation 0))
    (table-set! result "unsealed-calls" (owner-scope-control "unsealed-calls" generation 0))
    (table-set! result "gap-begin" (owner-scope-control "gap-begin" generation 0))
    (table-set! result "gap-end" (owner-scope-control "gap-end" generation 0))
    (table-set! result "calls" (owner-scope-control "calls" generation 0))
    (table-set! result "call-wall" (owner-scope-control "call-wall" generation 0))
    (table-set! result "call-cpu" (owner-scope-control "call-cpu" generation 0))
    (table-set! result "zero-timeout" (owner-scope-control "zero-timeout" generation 0))
    (table-set! result "finite-timeout" (owner-scope-control "finite-timeout" generation 0))
    (table-set! result "infinite-timeout" (owner-scope-control "infinite-timeout" generation 0))
    (table-set! result "ready" (owner-scope-control "ready" generation 0))
    (table-set! result "timed-out" (owner-scope-control "timed-out" generation 0))
    (table-set! result "interrupted" (owner-scope-control "interrupted" generation 0))
    (table-set! result "failed" (owner-scope-control "failed" generation 0))
    (table-set! result "clock-valid" (owner-scope-control "clock-valid" generation 0))
    (table-set! result "best-progress-ordinal" (owner-scope-control "best-progress-ordinal" generation 0))
    (table-set! result "peak-wall" (owner-scope-control "peak-wall" generation 0))
    (table-set! result "peak-due" (owner-scope-control "peak-due" generation 0))
    (table-set! result "peak-published" (owner-scope-control "peak-published" generation 0))
    (table-set! result "peak-consumed" (owner-scope-control "peak-consumed" generation 0))
    (table-set! result "peak-active" (owner-scope-control "peak-active" generation 0))
    (table-set! result "peak-outstanding" (owner-scope-control "peak-outstanding" generation 0))
    (table-set! result "peak-progress-ordinal" (owner-scope-control "peak-progress-ordinal" generation 0))
    (table-set! result "before-begin" (owner-scope-control "before-begin" generation 0))
    (table-set! result "before-end" (owner-scope-control "before-end" generation 0))
    (table-set! result "before-cpu" (owner-scope-control "before-cpu" generation 0))
    (table-set! result "before-gc-count" (owner-scope-control "before-gc-count" generation 0))
    (table-set! result "before-gc-wall" (owner-scope-control "before-gc-wall" generation 0))
    (table-set! result "before-gc-cpu" (owner-scope-control "before-gc-cpu" generation 0))
    (table-set! result "after-begin" (owner-scope-control "after-begin" generation 0))
    (table-set! result "after-end" (owner-scope-control "after-end" generation 0))
    (table-set! result "after-cpu" (owner-scope-control "after-cpu" generation 0))
    (table-set! result "after-gc-count" (owner-scope-control "after-gc-count" generation 0))
    (table-set! result "after-gc-wall" (owner-scope-control "after-gc-wall" generation 0))
    (table-set! result "after-gc-cpu" (owner-scope-control "after-gc-cpu" generation 0))
    result))
(def (call-with-owner-scope period procedure)
  (let ((generation #f) (closed? #f) (returned? #f) (report #f))
    (let (value
      (dynamic-wind
        (lambda ()
          ;; A captured business continuation may reenter, but a closed
          ;; observation is never reopened and cannot close a later scope.
          (unless generation
            (unless (= (owner-scope-control "supported" 0 0) 1)
              (error "owner scope diagnostic image required"))
            (let (admitted (owner-scope-control "open" 0 period))
              (unless (positive? admitted) (error "owner scope admission failed"))
              (set! generation admitted))))
        (lambda () (let (result (procedure generation)) (set! returned? #t) result))
        (lambda ()
          (when (and generation (not closed?))
            (set! closed? #t)
            ;; Measurement failure must not replace a business exception.
            (with-catch
              (lambda (_) (set! report (make-table test: equal?)))
              (lambda ()
                (let (status (owner-scope-control (if returned? "close" "abort") generation 0))
                  (if (zero? status) (set! report (owner-scope-report generation))
                    (begin (set! report (make-table test: equal?))
                      (table-set! report "close-error" status))))))))))
      (vector value report))))
(defrules with-owner-scope ()
  ((_ #f generation period body ...) (begin body ...))
  ((_ #t generation period body ...)
    (call-with-owner-scope period (lambda (generation) body ...))))
(defrules mailbox-scoped-progress ()
  ((_ #f generation address) (owner-wait-trace 11 address))
  ((_ #t generation address) (owner-scope-publish generation address)))
(defrules mailbox-scoped-source ()
  ((_ #f generation now due next completed active) (begin))
  ((_ #t generation now due next completed active)
    (owner-scope-source generation now due next completed active)))
(defrules mailbox-scoped-start ()
  ((_ #f generation epoch) (begin))
  ((_ #t generation epoch)
    (unless (zero? (owner-scope-control "epoch" generation epoch)) (error "owner source epoch association"))))
(defrules mailbox-scoped-access ()
  ((_ #f operation) (memv operation '(56 57 58 59 60 62)))
  ((_ #t operation) (memv operation '(64))))
(defrules mailbox-scoped-header-length ()
  ((_ #f observe? watch?) (if (or observe? watch?) 5 4))
  ((_ #t observe? watch?) 5))

;; Invoked only through the existing strong-root qualification export, on one
;; real VM owner. The caller retains its original aligned heartbeat word.
(def (owner-scope-vm-contract address)
  (def (publish generation)
    (unless (zero? (owner-scope-publish generation address)) (error "scope heartbeat deadline")))
  (let (result
    (call-with-owner-scope 1
      (lambda (generation)
        (unless (with-catch (lambda (_) #t)
                  (lambda () (call-with-owner-scope 1 (lambda (_) #t)) #f))
          (error "nested scope admitted"))
        (unless (= (owner-scope-control "active" generation 0) 1) (error "outer scope closed"))
        (publish generation)
        (##gc)
        (thread-sleep! 0.001)
        (publish generation)
        'original-value)))
    (let (report (vector-ref result 1))
      (unless (and (eq? (vector-ref result 0) 'original-value)
                   (= (table-ref report "complete") 1) (= (table-ref report "invalid") 0)
                   (= (table-ref report "clock-valid") 1) (positive? (table-ref report "calls"))
                   (> (table-ref report "after-gc-count") (table-ref report "before-gc-count")))
        (error "real owner GC/wait association"))))
  (let ((original (vector 'owner-original-exception)) (seen #f) (failed-generation #f))
    (with-catch (lambda (failure) (set! seen failure))
      (lambda () (call-with-owner-scope 1
        (lambda (generation) (set! failed-generation generation) (publish generation) (##gc) (raise original)))))
    (unless (and (eq? seen original)
                 (= (owner-scope-control "aborted" failed-generation 0) 1)
                 (= (owner-scope-control "complete" failed-generation 0) 0))
      (error "owner failure identity or retirement")))
  (let ((saved #f) (remaining 3) (cached #f) (new-generation #f))
    (dynamic-wind void
      (lambda ()
        (call/cc (lambda (done)
          (let (result (call-with-owner-scope 1
                 (lambda (generation)
                   (call/cc (lambda (continuation) (set! saved continuation)))
                   (publish generation)
                   'reentered-value)))
            (unless (eq? (vector-ref result 0) 'reentered-value) (error "continuation value changed"))
            (if cached
              (unless (and (eq? cached (vector-ref result 1))
                           (= (owner-scope-control "active" new-generation 0) 1)
                           (= (owner-scope-control "live-invalid" new-generation 0) 0)
                           (= (owner-scope-control "live-progress-count" new-generation 0) 0))
                (error "closed continuation contaminated later activation"))
              (begin (set! cached (vector-ref result 1))
                (set! new-generation (owner-scope-control "open" 0 1))
                (unless (positive? new-generation) (error "reuse admission"))))
            (if (positive? remaining)
              (begin (set! remaining (1- remaining)) (saved #t)) (done #t))))))
      (lambda ()
        (when new-generation
          (unless (zero? (owner-scope-control "abort" new-generation 0))
            (error "reuse scope cleanup"))))))
  (s64vector 0))
