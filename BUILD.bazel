load(
    "@gerbil_bazel//gerbil:defs.bzl",
    "gerbil_project_compile",
    "gerbil_project_test",
)
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

CARGO_GATE_ENV = [
    "AR",
    "CARGO_TARGET_DIR",
    "CC",
    "CXX",
    "DEVELOPER_DIR",
    "DYLD_LIBRARY_PATH",
    "GAMBOPT",
    "GERBIL_GSC",
    "GERBIL_HOME",
    "GERBIL_PATH",
    "GERBIL_SCHEME_RUST_WORKSPACE",
    "GITHUB_WORKSPACE",
    "HOME",
    "LD_LIBRARY_PATH",
    "LIBRARY_PATH",
    "MACOSX_DEPLOYMENT_TARGET",
    "NIX_CFLAGS_COMPILE",
    "NIX_LDFLAGS",
    "PATH",
    "PKG_CONFIG_PATH",
    "SDKROOT",
    "XDG_CACHE_HOME",
]

filegroup(
    name = "rust_sources",
    srcs = glob([
        "build-support/**/*",
        "crates/**/*.rs",
        "crates/**/ffi/**/*.c",
        "crates/**/ffi/**/*.h",
        "crates/**/scheme/**/*.ss",
        "crates/**/Cargo.toml",
        "crates/**/tests/unit/scenarios/**",
        "build-support/**/*.rs",
        "build-support/**/*.md",
        "build-support/**/Cargo.toml",
        "include/**/*.h",
    ]) + [
        "Cargo.lock",
        "Cargo.toml",
        "rust-toolchain.toml",
    ],
)

filegroup(
    name = "gerbil_sources",
    srcs = glob(["scheme/**/*"]) + [
        "build.ss",
        "ffi/runtime.c",
        "ffi/host_io.h",
        "gerbil.pkg",
    ],
)

[
    sh_test(
        name = "cargo_" + gate,
        size = {
            "check": "large",
            "test": "large",
            "clippy": "large",
        }[gate],
        timeout = {
            "check": "long",
            "test": "long",
            "clippy": "long",
        }[gate],
        srcs = ["//tools/bazel:cargo_gate.sh"],
        args = [gate],
        data = [
            ":gerbil_sources",
            ":rust_sources",
        ],
        env = {"GERBIL_SCHEME_RUST_CHECK_GENERATED_SCM": "1"},
        env_inherit = CARGO_GATE_ENV,
        tags = [
            "exclusive",
            "manual",
            "no-sandbox",
        ],
    )
    for gate in [
        "check",
        "test",
        "clippy",
    ]
]

sh_test(
    name = "cargo_all",
    size = "large",
    timeout = "long",
    srcs = ["//tools/bazel:cargo_gate.sh"],
    args = ["all"],
    data = [
        ":gerbil_sources",
        ":rust_sources",
    ],
    env = {
        "GERBIL_SCHEME_RUST_CHECK_GENERATED_SCM": "1",
    },
    env_inherit = CARGO_GATE_ENV,
    tags = [
        "exclusive",
        "no-sandbox",
    ],
)

gerbil_project_compile(
    name = "gerbil_native_compile",
    srcs = [":gerbil_sources"],
    args = ["compile"],
    build_script = "build.ss",
)

gerbil_project_test(
    name = "gerbil_native",
    timeout = "short",
    project = ":gerbil_native_compile",
    tests = ["scheme/runtime-test.ss"],
)

test_suite(
    name = "ci",
    tests = [
        # Each complete gate retains its existing watchdog. Exclusive tests
        # reuse one cache without waiting on another Cargo writer's lock.
        ":cargo_check",
        ":cargo_test",
        ":cargo_clippy",
        ":gerbil_native",
    ],
)
