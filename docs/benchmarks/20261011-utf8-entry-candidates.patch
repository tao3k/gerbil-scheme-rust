index 0000000..cdb79e1
--- /dev/null
+++ b/crates/gerbil-scheme-qualification/benches/utf8/sample.rs
@@ -0,0 +1,29 @@
+//! Consumer finishes each current text before reusing its exclusive destination.
+use super::{Root, buffer, convert};
+
+pub(super) fn run(values: &[Root], texts: &[String], jobs: usize, mode: i32) -> (usize, usize) {
+    // Allocation and the first growth remain inside sample timing, not setup.
+    let mut output = Vec::new();
+    let mut total = 0;
+    let mut capacity_total = 0;
+    for index in 0..jobs {
+        let slot = index % values.len();
+        if mode == 7 || mode == 8 {
+            let text = if mode == 7 {
+                buffer::reuse(&values[slot], &mut output)
+            } else {
+                buffer::reuse_direct(&values[slot], &mut output)
+            }
+            .expect("complete fresh encoding");
+            assert_eq!(text, texts[slot], "changing text exact content");
+            total += std::hint::black_box(text).len();
+            capacity_total += output.capacity();
+        } else {
+            let text = convert(&values[slot], mode);
+            assert_eq!(text, texts[slot], "changing text exact content");
+            capacity_total += text.capacity();
+            total += std::hint::black_box(text).len();
+        }
+    }
+    (total, capacity_total)
+}
