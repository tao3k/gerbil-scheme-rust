;;; SPDX-License-Identifier: Apache-2.0 OR LGPL-2.1-or-later
;;; Owner-local execution contexts, independent of job results and host credit.
;;; Phases: runnable, lease wait, external wait, Actor barrier, running, retired.
(defstruct service-runtime (budget fair? events? counts entered retired passes parked contexts))
(defstruct service-runtime-context (ledger short? phase))
(def gerbil-rs-runtime-context (make-parameter #f))
(def (gerbil-rs-runtime-state budget)
  (let (work (service-budget-work budget)) (and work (service-work-runtime work))))
(def (runtime-move! token phase)
  (let ((ledger (service-runtime-context-ledger token))
        (old (service-runtime-context-phase token))
        (offset (if (service-runtime-context-short? token) 0 1)))
    (unless (= old phase)
      (let (counts (service-runtime-counts ledger))
        (when (< old 5)
          (let (i (+ (* old 2) offset))
            (unless (positive? (vector-ref counts i)) (error "runtime context count underflow"))
            (vector-set! counts i (1- (vector-ref counts i)))))
        (when (< phase 5)
          (let (i (+ (* phase 2) offset)) (vector-set! counts i (1+ (vector-ref counts i)))))
        (when (= old 5) (set! (service-runtime-entered ledger) (1+ (service-runtime-entered ledger))))
        (when (= phase 5) (set! (service-runtime-retired ledger) (1+ (service-runtime-retired ledger))))
        (set! (service-runtime-context-phase token) phase)))))
(def (runtime-register/locked! budget short?)
  (let (ledger (gerbil-rs-runtime-state budget))
    (and ledger (let (token (make-service-runtime-context ledger short? 5))
                  (runtime-move! token 0) token))))
(def (make-gerbil-rs-runtime-context budget short?)
  (and (gerbil-rs-runtime-state budget)
    (budget-locked budget (lambda () (runtime-register/locked! budget short?)))))
(def (make-gerbil-rs-runtime-contexts budget short? count)
  (let (ledger (gerbil-rs-runtime-state budget))
    (and ledger
      (let (tokens (make-vector count))
        (def (register! make!)
          (let loop ((i 0))
            (when (< i count)
              (vector-set! tokens i (make! budget short?)) (loop (1+ i)))))
        ;; One mailbox dispatch publishes all independent child contexts. The
        ;; mirrored control retains its prior per-child critical sections.
        (if (service-runtime-events? ledger)
          (budget-locked budget (lambda () (register! runtime-register/locked!)))
          (register! make-gerbil-rs-runtime-context))
        tokens))))
(def (call-with-gerbil-rs-runtime-context token thunk)
  (if (not token) (thunk)
    (parameterize ((gerbil-rs-runtime-context token))
      (let* ((ledger (service-runtime-context-ledger token))
             (budget (service-runtime-budget ledger))
             (contexts (service-runtime-contexts ledger)))
        ;; Activation publication and retirement share the existing budget lock.
        ;; A collector cannot observe retired totals before the index is removed.
        ;; The user thunk is outside this critical section, including reentry.
        (dynamic-wind
          (lambda ()
            (budget-locked budget (lambda ()
              (when contexts
                (let (thread (current-thread))
                  (table-set! contexts thread (cons token (table-ref contexts thread [])))))
              (runtime-move! token 0)))) thunk
          (lambda ()
            (budget-locked budget (lambda ()
              (when contexts
                (let* ((thread (current-thread)) (stack (table-ref contexts thread [])))
                  (unless (and (pair? stack) (eq? (car stack) token)) (error "foreign runtime activation exit"))
                  (if (null? (cdr stack)) (table-set! contexts thread)
                    (table-set! contexts thread (cdr stack)))))
              (runtime-move! token 5)))))))))
(def (runtime-current! budget phase)
  (let (ledger (gerbil-rs-runtime-state budget))
    (when ledger
      (let (token (gerbil-rs-runtime-context))
        ;; A retained old epoch is not authority over the current ledger.
        (when (and token (eq? ledger (service-runtime-context-ledger token)))
          (runtime-move! token phase))))))
(def (runtime-blocking! budget phase)
  (let (ledger (gerbil-rs-runtime-state budget))
    (when (and ledger (service-runtime-events? ledger)) (runtime-current! budget phase))))
(def (runtime-authoritative-counts budget ledger)
  (if (not (service-runtime-events? ledger)) (service-runtime-counts ledger)
    (let* ((counts (vector-copy (service-runtime-counts ledger)))
           (owner (service-budget-owner budget))
           (stack (and owner (table-ref (service-runtime-contexts ledger) owner [])))
           (token (and (pair? stack) (car stack))))
      ;; The budget already owns the grant. A selected blocked receiver stays
      ;; phase 1 until its wait returns; selection alone is not execution.
      (when (and token (= (service-runtime-context-phase token) 0))
        (let (offset (if (service-runtime-context-short? token) 0 1))
          (vector-set! counts offset (1- (vector-ref counts offset)))
          (vector-set! counts (+ 8 offset) 1)))
      (when (and (= (service-runtime-entered ledger) (service-runtime-retired ledger))
                 (positive? (table-length (service-runtime-contexts ledger))))
        (error "retired runtime retained activation ownership"))
      counts)))
(def (gerbil-rs-runtime-pass? budget short-ready? ready? dispatch-due?)
  (budget-locked budget (lambda ()
  (let* ((ledger (gerbil-rs-runtime-state budget)) (c (service-runtime-counts ledger))
         (short-runnable? (or dispatch-due? (positive? (+ (vector-ref c 0) (vector-ref c 2) (vector-ref c 8)))))
         (any-runnable? (or short-runnable? (positive? (+ (vector-ref c 1) (vector-ref c 3) (vector-ref c 9)))))
         (pass? (if (service-runtime-fair? ledger)
                  (and (not short-ready?) (or short-runnable? (and (not ready?) any-runnable?)))
                  (not ready?))))
    (if pass? (set! (service-runtime-passes ledger) (1+ (service-runtime-passes ledger)))
      (when (not ready?) (set! (service-runtime-parked ledger) (1+ (service-runtime-parked ledger)))))
    pass?))))
(def (gerbil-rs-runtime-snapshot budget)
  (budget-locked budget (lambda ()
  (let (ledger (gerbil-rs-runtime-state budget))
    (if ledger
      (list->s64vector (append (list 1 (if (service-runtime-fair? ledger) 1 0))
        (vector->list (runtime-authoritative-counts budget ledger))
        (list (service-runtime-entered ledger) (service-runtime-retired ledger)
              (service-runtime-passes ledger) (service-runtime-parked ledger))))
      (make-s64vector 16 0))))))
