@@ -1540,6 +1552,15 @@ impl Handle {
     }
 }
 
+static BRIDGE_INJECT: [std::sync::atomic::AtomicU64; 5] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 5];
+
+/// Isolated bridge diagnostic; never linked into the production dependency.
+#[unsafe(no_mangle)]
+pub extern "C" fn tokio_bridge_injection_stat(field: usize) -> u64 {
+    BRIDGE_INJECT[field].load(std::sync::atomic::Ordering::Relaxed)
+}
+
