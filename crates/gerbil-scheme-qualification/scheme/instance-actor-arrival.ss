;; Raw mailbox control isolates the library service protocol. The data, handler,
;; independent oracle, active3/window128 and arrival clock remain identical.
(def (actor-arrival-channel raw? (drain? #f) (direct? #f))
  (if (not raw?)
    (vector
      (lambda (input) (s64vector-ref (orders-endpoint (vector (s64vector 1 -1 1) input)) 0))
      (lambda () (orders-endpoint (vector (s64vector 3))))
      (lambda (id) (orders-endpoint (vector (s64vector 2 id))))
      void)
    (let* ((receiver (current-thread)) (workers (make-vector 4 #f))
           (next 0) (reply #f) (consumed 0)
           (buffer (and drain? (make-vector 3 #f))) (ready-count 0) (cursor 0))
      (def (stop!)
        (vector-for-each (lambda (worker) (when (thread? worker) (thread-send worker 'stop))) workers)
        (vector-for-each (lambda (worker) (when (thread? worker) (thread-join! worker 5))) workers)
        (when drain?
          ;; Join first: every admitted handler has now posted a response. Clear
          ;; only this channel's known outstanding replies, including captured slots.
          (let ((captured (- ready-count cursor)) (remaining (- next consumed)))
            (let clear ((i cursor))
              (when (< i ready-count) (vector-set! buffer i #f) (clear (1+ i))))
            (let clear ((left (- remaining captured)))
              (when (positive? left)
                (unless (thread-receive 0 #f) (error "missing joined mailbox response"))
                (clear (1- left)))))))
      (with-catch (lambda (failure) (stop!) (raise failure))
        (lambda ()
          (let create ((index 0))
            (when (and (not direct?) (< index 4))
              (vector-set! workers index
                (spawn (lambda ()
                  (let work ()
                    (let (message (thread-receive))
                      (unless (eq? message 'stop)
                        (thread-send receiver
                          (with-catch (lambda (failure) (vector (vector-ref message 0) #t failure))
                            (lambda () (vector (vector-ref message 0) #f
                              (orders-service-handler index (vector-ref message 1))))))
                        (work)))))))
              (create (1+ index))))))
      (vector
        (lambda (input (slot #f))
          (let* ((ordinal next)
                 (id (if drain? (+ (* ordinal 3) (or slot (modulo ordinal 3))) ordinal)))
            (set! next (1+ next))
            (if direct?
              (thread-send receiver
                (with-catch (lambda (failure) (vector id #t failure))
                  (lambda () (vector id #f (orders-service-handler 0 input)))))
              (thread-send (vector-ref workers (modulo ordinal 4)) (vector id input))) id))
        (lambda ()
          (if drain?
            (begin
              (unless (= cursor ready-count) (error "mailbox snapshot not independently retired"))
              (set! cursor 0) (set! ready-count 0)
              (let collect ()
                (let (message (thread-receive 0 #f))
                  (when message
                    (vector-set! buffer ready-count message)
                    (set! ready-count (1+ ready-count))
                    (when (< ready-count 3) (collect)))))
              ;; Ready work requires no scheduling handoff. Yield only when the
              ;; mailbox is empty; the captured set remains bounded by active3.
              (when (zero? ready-count)
                (thread-yield!)
                (let collect ()
                  (let (message (thread-receive 0 #f))
                    (when message
                      (vector-set! buffer ready-count message)
                      (set! ready-count (1+ ready-count))
                      (when (< ready-count 3) (collect))))))
              (let (ids (make-s64vector ready-count))
                (let copy ((i 0))
                  (when (< i ready-count)
                    (s64vector-set! ids i (vector-ref (vector-ref buffer i) 0))
                    (copy (1+ i)))) ids))
            (begin
              (when reply (error "raw Actor result custody not retired"))
              (thread-yield!)
              (set! reply (thread-receive 0 #f))
              (if reply (s64vector (vector-ref reply 0)) (s64vector)))))
        (lambda (id)
          (let (value
                (if drain?
                  (begin
                    (unless (and (< cursor ready-count) (= id (vector-ref (vector-ref buffer cursor) 0)))
                      (error "mailbox snapshot result identity"))
                    (let (value (vector-ref buffer cursor))
                      (vector-set! buffer cursor #f) (set! cursor (1+ cursor))
                      (set! consumed (1+ consumed)) value))
                  (begin
                    (unless (and reply (= (vector-ref reply 0) id)) (error "raw Actor result identity"))
                    (let (value reply) (set! reply #f) value))))
            (if (vector-ref value 1) (raise (vector-ref value 2)) (vector-ref value 2))))
        stop!))))
;; Qualification-only: the existing Gerbil service, with no per-message Rust entry.
;; Header [50, rate, seconds, progress-address]. The caller owns the aligned
;; atomic progress word throughout this synchronous call, including unwinding.
(def (actor-arrival-input id)
  (let (data (make-s64vector 14 0))
    (s64vector-set! data 0 id)
    (let loop ((line 0))
      (when (< line 4)
        (let (offset (+ 2 (* line 3)))
          (s64vector-set! data offset (modulo (+ id line) 16))
          (s64vector-set! data (1+ offset) (1+ (modulo line 5)))
          (s64vector-set! data (+ offset 2) (modulo (+ (* id 17) (* line 31)) 10000)))
        (loop (1+ line))))
    (vector (s64vector 77 1) data)))
(def (actor-arrival-verify! id value)
  ;; Independent result oracle; do not call the implementation under test again.
  (unless (and (s64vector? value) (= (s64vector-length value) 21)
               (= (s64vector-ref value 0) id) (= (s64vector-ref value 1) 10)
               (= (s64vector-ref value 3) 1) (= (s64vector-ref value 4) 0))
    (error "native Actor result identity/shape"))
  (let (gross 0)
    (let loop ((line 0))
      (when (< line 4)
        (let* ((sku (modulo (+ id line) 16))
               (amount (* (1+ line) (modulo (+ (* id 17) (* line 31)) 10000))))
          (unless (= (s64vector-ref value (+ sku 5)) amount) (error "native Actor SKU total"))
          (set! gross (+ gross amount)))
        (loop (1+ line))))
    (unless (= gross (s64vector-ref value 2)) (error "native Actor gross"))
    (let loop ((sku 0))
      (when (< sku 16)
        (unless (< (modulo (- sku (modulo id 16)) 16) 4)
          (unless (zero? (s64vector-ref value (+ sku 5))) (error "native Actor empty SKU")))
        (loop (1+ sku))))))
(def (actor-arrival-percentile histogram count numerator denominator)
  (if (zero? count) -1
    (let (target (quotient (+ (* count numerator) (1- denominator)) denominator))
      (let loop ((bucket 0) (sum 0))
        (let (following (+ sum (u64vector-ref histogram bucket)))
          (if (>= following target) (* (1+ bucket) 1000)
            (loop (1+ bucket) following)))))))
(def (actor-arrival-pipeline-contract!)
  (let ((channel (actor-arrival-channel #t #t)) (received 0))
    (dynamic-wind void
      (lambda ()
        (let send ((id 0))
          (when (< id 3) ((vector-ref channel 0) (actor-arrival-input id)) (send (1+ id))))
        (let receive ()
          (when (< received 3)
            (let (ready ((vector-ref channel 1)))
              ;; Captured mailbox graphs must survive collection independently.
              (##gc)
              (let consume ((i 0))
                (when (< i (s64vector-length ready))
                  (let* ((id (s64vector-ref ready i)) (value ((vector-ref channel 2) id)))
                    (actor-arrival-verify! (quotient id 3) value)
                    (unless (with-catch (lambda (_) #t)
                              (lambda () ((vector-ref channel 2) id) #f))
                      (error "duplicate mailbox retirement accepted"))
                    (set! received (1+ received)))
                  (consume (1+ i)))))
            (receive)))
        ;; Stop with captured and unconsumed replies, including a caught handler
        ;; failure. Joined workers must leave no response in the gateway mailbox.
        (let (bad (actor-arrival-input 3))
          (s64vector-set! (vector-ref bad 1) 2 16)
          ((vector-ref channel 0) bad))
        ((vector-ref channel 0) (actor-arrival-input 4))
        ((vector-ref channel 0) (actor-arrival-input 5))
        ((vector-ref channel 1)))
      (vector-ref channel 3))
    (when (thread-receive 0 #f) (error "joined mailbox retained a response"))))
;; Differential edge cases are cold; the independent measured oracle is unchanged.
(def (actor-arrival-access-contract!)
  (def (observe input fast? rank-value)
    (let ((old orders-native-access?) (calls 0))
      (dynamic-wind (lambda () (set! orders-native-access? fast?))
        (lambda ()
          (with-catch (lambda (_) (vector #t #f calls))
            (lambda ()
              (let (value (orders-handler/rank (lambda () (set! calls (1+ calls)) rank-value) 0 input))
                (vector #f value calls)))))
        (lambda () (set! orders-native-access? old)))))
  (let* ((ordinary (vector-ref (actor-arrival-input 7) 1))
         (bulk (make-s64vector 146 1))
         (cases (list ordinary #f (s64vector) (s64vector 1 0 2 3)
           (s64vector 0 0 16 1 2) (s64vector 0 0 2 0 3) (s64vector 0 0 2 1 -1)
           (s64vector 9223372036854775807 0 3 1 4611686018427387904)
           (s64vector -9223372036854775808 0 3 1 7)
           (s64vector 0 0 3 2 9223372036854775807)
           (s64vector 0 0 3 9223372036854775807 0)
           (s64vector 0 1 3 1 7) bulk)))
    (s64vector-set! bulk 1 0)
    (for-each
      (lambda (input)
        (for-each (lambda (rank)
          (let ((original (observe input #f rank)) (native (observe input #t rank)))
            (unless (equal? original native) (error "native data access changed value/error/callback count"))))
          (list 1 4611686018427387904 1/2))) cases)
    (##gc)))
(def (orders-actor-arrival-reference command)
  (let* ((header (vector-ref command 0))
         (rate (s64vector-ref header 1)) (seconds (s64vector-ref header 2))
         (progress (s64vector-ref header 3))
         (state (orders-endpoint (vector (s64vector 15)))))
    (unless (and (= (s64vector-length header) 4) (<= 1 rate 1000000)
                 (<= 1 seconds 10) (<= (* rate seconds) 10000000)
                 (positive? progress) (zero? (s64vector-ref state 0))
                 (zero? (s64vector-ref state 3)) (zero? (s64vector-ref state 7)))
      (error "native Actor arrivals require idle Snapshot service"))
    (when (memv (s64vector-ref header 0) '(52 53)) (actor-arrival-pipeline-contract!))
    (when (= (s64vector-ref header 0) 54) (actor-arrival-access-contract!))
    (let* ((histogram (make-u64vector 5000000 0))
           (total (* rate seconds)) (issued 0) (completed 0) (rejected 0)
           (front []) (back []) (staged 0) (active 0) (pending (make-table test: eqv?))
           (leases (make-s64vector 3 -1)) (applications (make-s64vector 3 -1))
           (old-access? orders-native-access?) (fast-access? (= (s64vector-ref header 0) 54))
           (pipeline? (memv (s64vector-ref header 0) '(52 53)))
           (direct? (= (s64vector-ref header 0) 53))
           (channel (actor-arrival-channel (memv (s64vector-ref header 0) '(51 52 53 54)) pipeline? direct?))
           (start (owner-wait-trace 1 0)) (offered-end 0) (max-lag 0))
      (def (planned id) (+ start (quotient (* id 1000000000) rate)))
      (def (free-slot)
        (let find ((slot 0))
          (cond ((= slot 3) (error "mailbox active credit has no free slot"))
                ((= -1 (s64vector-ref leases slot)) slot)
                (else (find (1+ slot))))))
      (def (application-id native-id)
        (if pipeline?
          (let (slot (modulo native-id 3))
            (unless (= native-id (s64vector-ref leases slot))
              (error "stale or duplicate mailbox lease"))
            (s64vector-ref applications slot))
          (table-ref pending native-id)))
      (def (release-input!)
        (when (null? front) (set! front (reverse back)) (set! back []))
        (let (id (car front))
          (set! front (cdr front)) (set! staged (1- staged))
          (when (>= (- (owner-wait-trace 1 0) (planned id)) 5000000000)
            (error "native staged request expired"))
          (if pipeline?
            (let* ((slot (free-slot)) (token ((vector-ref channel 0) (actor-arrival-input id) slot)))
              (s64vector-set! leases slot token) (s64vector-set! applications slot id))
            (let (native-id ((vector-ref channel 0) (actor-arrival-input id)))
              (table-set! pending native-id id)))
          (set! active (1+ active))))
      (def (consume-ready!)
        (let (ready ((vector-ref channel 1)))
          (let loop ((i 0))
            (when (< i (s64vector-length ready))
              (let* ((native-id (s64vector-ref ready i)) (id (application-id native-id))
                     (value ((vector-ref channel 2) native-id)))
                (actor-arrival-verify! id value)
                (let* ((now (owner-wait-trace 1 0)) (latency (- now (planned id))))
                  (unless (< latency 5000000000) (error "native Actor request exceeded five seconds"))
                  (let (bucket (quotient latency 1000))
                    (u64vector-set! histogram bucket (1+ (u64vector-ref histogram bucket)))))
                (unless (zero? (owner-wait-trace 11 progress)) (error "native Actor progress deadline"))
                (if pipeline?
                  (let (slot (modulo native-id 3))
                    (s64vector-set! leases slot -1) (s64vector-set! applications slot -1))
                  (table-set! pending native-id))
                (set! active (1- active)) (set! completed (1+ completed))
                ;; Return the independent active credit directly to existing input,
                ;; before generator catch-up. This does not merge handler messages.
                (when (and pipeline? (< active 3) (positive? staged)) (release-input!)))
              (loop (1+ i))))))
      (dynamic-wind (lambda () (set! orders-native-access? fast-access?)) (lambda ()
      (let drive ()
        ;; A bounded generator turn prevents catch-up from starving green threads.
        ;; Every original planned arrival is counted, including rejected arrivals.
        (let emit ((left 128))
          (when (and (positive? left) (< issued total))
            (let (now (owner-wait-trace 1 0))
              (when (>= now (planned issued))
                (set! max-lag (max max-lag (- now (planned issued))))
                (if (< (+ staged active) 128)
                  (begin (set! back (cons issued back)) (set! staged (1+ staged)))
                  (set! rejected (1+ rejected)))
                (set! issued (1+ issued))
                (when (= issued total) (set! offered-end now))
                (emit (1- left))))))
        ;; Existing active3 credits, not a new queue or larger execution batch.
        (let supply ()
          (when (and (< active 3) (positive? staged)) (release-input!) (supply)))
        (if (positive? active) (consume-ready!) (thread-yield!))
        (when (or (< issued total) (positive? staged) (positive? active)) (drive)))
      (let ((elapsed (- (owner-wait-trace 1 0) start)))
        (unless (and (= (+ completed rejected) total) (zero? (table-length pending))
                     (equal? leases (s64vector -1 -1 -1))
                     (equal? applications (s64vector -1 -1 -1)))
          (error "native arrival accounting or outstanding custody"))
        (s64vector total completed rejected elapsed (- offered-end start)
          (actor-arrival-percentile histogram completed 99 100)
          (actor-arrival-percentile histogram completed 999 1000) max-lag)))
        (lambda ()
          (with-catch (lambda (failure) (set! orders-native-access? old-access?) (raise failure))
            (lambda () ((vector-ref channel 3)) (set! orders-native-access? old-access?))))))))
