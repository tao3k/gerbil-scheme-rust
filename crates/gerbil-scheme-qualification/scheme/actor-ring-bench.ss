;;; Standalone standard Gerbil Actor ring. No Rust scheduler or VM pool.
;;; Work transfers exclude bootstrap, ready, completion and stop envelopes.
(import (prefix-in :std/actor actor/) :std/encoding/json :std/error :std/sync/threads)
(export main)

(extern ring-wall)
(begin-foreign
 (namespace ("gerbil-scheme-rust/crates/gerbil-scheme-qualification/scheme/actor-ring-bench#" ring-wall))
 (c-declare "#include <time.h>\nstatic double ring_wall(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (double)t.tv_sec + (double)t.tv_nsec/1e9; }")
 (define ring-wall (c-lambda () double "ring_wall")))

(def protocol "/gerbil-scheme/qualification/ring/v1")
(def (receive-message) (actor/<- protocol: protocol (message message)))
(def (send-message peer message) (actor/-> peer message protocol))
(def (report phase . fields)
  (write-json (current-output-port) (list->hash-table (cons (cons 'phase phase) fields)))
  (newline)
  (force-output))

(def (ring-worker source)
  (let (next (receive-message))
    (send-message source 'ready)
    (let loop ((count 0))
      (let (message (receive-message))
        (cond
         ((eq? message 'stop) count)
         ((and (integer? message) (> message 0))
          (if (= message 1)
            (send-message source 'complete)
            (send-message next (- message 1)))
          (loop (+ count 1)))
         (else (error "Invalid ring message" message)))))))

(def (main actor-count message-count)
  (let ((n (string->number actor-count)) (m (string->number message-count)))
    (unless (and (exact-integer? n) (>= n 2)
                 (exact-integer? m) (> m 0))
      (error "Expected actor count >= 2 and positive work message count"))
    (unless (= (##current-vm-processor-count) 1)
      (error "This benchmark requires one VM processor; use -:p1"))
    (report "create-begin" (cons 'actors n) (cons 'work_messages m))
    (let* ((source (actor/actor-local-peer))
           (threads (make-vector n #f))
           (peers (make-vector n #f))
           (created 0)
           (started (ring-wall))
           (started-cpu (cpu-time)))
      ;; Failure cleanup only; normal teardown sends stop and joins every Actor.
      (try
       (let create ((i 0))
         (when (< i n)
           (let (thread (spawn ring-worker source))
             (vector-set! threads i thread)
             (set! created (+ i 1))
             (vector-set! peers i (actor/LocalActor thread)))
           (create (+ i 1))))
       (report "created" (cons 'wall_s (- (ring-wall) started))
         (cons 'cpu_s (- (cpu-time) started-cpu)))
       (let ((ready-start (ring-wall)) (ready-cpu (cpu-time)))
         (let bootstrap ((i 0))
           (when (< i n)
             (send-message (vector-ref peers i)
               (vector-ref peers (modulo (+ i 1) n)))
             (bootstrap (+ i 1))))
         (let ready ((i 0))
           (when (< i n)
             (unless (eq? (receive-message) 'ready) (error "Invalid ready"))
             (ready (+ i 1))))
         (report "ready" (cons 'wall_s (- (ring-wall) ready-start))
           (cons 'cpu_s (- (cpu-time) ready-cpu))))
       (let ((work-start (ring-wall)) (work-cpu (cpu-time)))
         (send-message (vector-ref peers 0) m)
         (unless (eq? (receive-message) 'complete) (error "Invalid completion"))
         (let (elapsed (- (ring-wall) work-start))
           (report "work-complete" (cons 'work_messages m)
             (cons 'wall_s elapsed) (cons 'cpu_s (- (cpu-time) work-cpu))
             (cons 'messages_per_s (/ m elapsed)))))
       (let (cleanup-start (ring-wall))
         (let stop ((i 0))
           (when (< i n)
             (send-message (vector-ref peers i) 'stop)
             (stop (+ i 1))))
         (let join ((i 0) (total 0))
           (if (< i n)
             (let* ((count (thread-join! (vector-ref threads i)))
                    (expected (if (< i m) (+ 1 (quotient (- m 1 i) n)) 0)))
               (unless (= count expected) (error "Ring count mismatch" i count expected))
               (vector-set! threads i #f)
               (vector-set! peers i #f)
               (join (+ i 1) (+ total count)))
             (begin
               (unless (= total m) (error "Total count mismatch" total))
               (report "joined" (cons 'validated_messages total)
                 (cons 'wall_s (- (ring-wall) cleanup-start)))))))
       (finally
        (let cleanup ((i 0))
          (when (< i created)
            (let (thread (vector-ref threads i))
              (when thread
                (with-catch void (lambda () (thread-terminate! thread)))
                (with-catch void (lambda () (thread-join! thread)))))
            (cleanup (+ i 1))))))
      (let (gc-start (ring-wall))
        (##gc)
        (report "reclaimed" (cons 'wall_s (- (ring-wall) gc-start)))))))
