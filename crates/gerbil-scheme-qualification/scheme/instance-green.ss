;; Persistent local mailbox actors. All scheduling and references stay in Scheme.
(def green-workers #())
(defstruct green-turn (reply output start count rounds quantum active progress first fail))
(def (green-first-progress! turn worker)
  (unless (vector-ref (green-turn-first turn) 0)
    (let loop ((i 0) (least (green-turn-count turn)))
      (if (= i (green-turn-active turn))
        (vector-set! (green-turn-first turn) 0
          (if (= (green-turn-active turn) 1) 0 least))
        (loop (1+ i) (if (= i worker) least
                        (min least (vector-ref (green-turn-progress turn) i))))))))
(def (green-execute! turn worker)
  (let loop ((job worker) (done 0))
    (when (< job (green-turn-count turn))
      (when (and (= worker (green-turn-fail turn)) (zero? done))
        (error "injected Scheme mailbox actor failure"))
      (s64vector-set! (green-turn-output turn) job
        (+ (green-turn-start turn) job (checksum (green-turn-rounds turn))))
      (vector-set! (green-turn-progress turn) worker (1+ done))
      (when (and (positive? (green-turn-quantum turn))
                 (zero? (modulo (1+ done) (green-turn-quantum turn))))
        (thread-yield!))
      (loop (+ job (green-turn-active turn)) (1+ done))))
  (green-first-progress! turn worker))
(def (green-worker worker)
  (let loop ()
    (let (message (thread-receive))
      (unless (eq? message 'stop)
        (let (ok (with-catch (lambda (_) #f)
                    (lambda () (green-execute! message worker) #t)))
          (thread-send (green-turn-reply message) ok))
        (loop)))))
(def (green-start! count)
  (unless (and (zero? (vector-length green-workers)) (<= 1 count 64))
    (error "invalid mailbox actor population" count))
  (set! green-workers (make-vector count))
  (let loop ((i 0))
    (when (< i count)
      (vector-set! green-workers i (spawn (lambda () (green-worker i))))
      (loop (1+ i))))
  (s64vector count))
(def (green-stop!)
  (let (count (vector-length green-workers))
    (vector-for-each (lambda (worker) (thread-send worker 'stop)) green-workers)
    (vector-for-each thread-join! green-workers)
    (set! green-workers #())
    (s64vector count)))
(def (green-batch value)
  (let* ((start (s64vector-ref value 2)) (count (s64vector-ref value 3))
         (rounds (s64vector-ref value 4)) (quantum (s64vector-ref value 5))
         (active (s64vector-ref value 6)) (fail (s64vector-ref value 7)))
    (unless (and (<= 1 count 4096) (<= 0 rounds 1000000) (<= 0 quantum)
                 (<= 0 active (vector-length green-workers))
                 (or (= fail -1) (< -1 fail active)))
      (error "invalid bounded actor turn"))
    (let (output (make-s64vector (1+ count) 0))
      (if (zero? active)
        (let loop ((job 0))
          (when (< job count)
            (s64vector-set! output job (+ start job (checksum rounds)))
            (loop (1+ job))))
        (let* ((first (vector #f)) (progress (make-vector active 0))
               (turn (make-green-turn (current-thread) output start count rounds
                       quantum active progress first fail)))
          (let loop ((worker 0))
            (when (< worker active)
              (thread-send (vector-ref green-workers worker) turn)
              (loop (1+ worker))))
          ;; Drain every acknowledgement before throwing or returning through FFI.
          (let loop ((left active) (ok #t))
            (if (zero? left)
              (unless ok (error "mailbox actor turn failed"))
              (let (reply (thread-receive)) (loop (1- left) (and ok reply)))))
          (s64vector-set! output count (vector-ref first 0))))
      output)))
(def (instance-green-call value)
  (case (s64vector-ref value 1)
    ((0) (green-start! (s64vector-ref value 2)))
    ((1) (green-batch value))
    ((2) (green-stop!))
    ((3) (green-await-batch (= (s64vector-ref value 2) 1) (s64vector-ref value 3)))
    (else (error "invalid mailbox actor command"))))

(def (green-await-batch concurrent? count)
  (unless (<= 1 count 64) (error "invalid bounded timer population" count))
  (let ((pending []) (sum 0))
    (let loop ((left count))
      (when (positive? left)
        (let (work (lambda () (thread-sleep! 0.001) (checksum 64)))
          (if concurrent? (set! pending (cons (spawn work) pending))
              (set! sum (+ sum (work)))))
        (loop (1- left))))
    (for-each (lambda (worker) (set! sum (+ sum (thread-join! worker)))) pending)
    (s64vector sum)))
