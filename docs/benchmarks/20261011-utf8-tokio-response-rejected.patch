+//! Same-owner ABBA admission controls; collect every regression before rejection.
+use super::{GerbilRuntime, SCENARIOS, buffer, convert, latency, texts_for_scenario};
+use std::{
+    sync::{Arc, mpsc as std_mpsc},
+    thread,
+    time::Instant,
+};
+use tokio::{
+    runtime::Runtime,
+    sync::{mpsc, oneshot},
+    task::JoinSet,
+};
+
+pub(super) fn run() {
+    latency::contracts();
+    let workers = thread::available_parallelism().unwrap().get();
+    let callers = workers.checked_mul(2).unwrap();
+    let host = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(workers)
+        .build()
+        .unwrap();
+    let (send, receive) = mpsc::channel(workers);
+    let (ready, wait) = std_mpsc::channel();
+    let owner = thread::spawn(move || owner(receive, ready));
+    wait.recv().unwrap();
+    println!(
+        "UTF8-QUEUE-MATCHED-METHOD workers={workers} callers={callers} capacity={workers} scheme_owners=1 workload=closed_loop parser_parallelism=false samples_per_variant=20 response_channel_capacity=1 comparator=per_request_oneshot candidate=per_caller_mpsc"
+    );
+    let requested = std::env::args().nth(2).filter(|arg| arg != "--bench");
+    let mut admitted = true;
+    for (corpus, name) in SCENARIOS.iter().enumerate() {
+        if requested
+            .as_deref()
+            .is_some_and(|s| s != "all" && s != *name)
+        {
+            continue;
+        }
+        let texts = Arc::new(texts_for_scenario(name));
+        for jobs in [1_000, 10_000, 100_000] {
+            admitted &= compare(&host, &send, &texts, corpus, jobs, callers);
+        }
+    }
+    drop(send);
+    owner.join().unwrap();
+    println!("UTF8-QUEUE-MATCHED-COMPLETE admitted={admitted}");
+    assert!(admitted, "slower candidate rejected; all loads collected");
+}
+
+fn quantiles(rows: &[[u64; 4]]) -> [u64; 8] {
+    let mut result = [0; 8];
+    for field in 0..4 {
+        let mut sorted: Vec<_> = rows.iter().map(|row| row[field]).collect();
+        sorted.sort_unstable();
+        for (column, p) in [95, 99].iter().enumerate() {
+            result[field * 2 + column] = latency::percentile(&sorted, *p);
+        }
+    }
+    result
+}
+
+fn compare(
+    host: &Runtime,
+    send: &mpsc::Sender<Request>,
+    texts: &Arc<Vec<String>>,
+    corpus: usize,
+    jobs: usize,
+    callers: usize,
+) -> bool {
+    let name = SCENARIOS[corpus];
+    let mut records: [Vec<[f64; 9]>; 2] = std::array::from_fn(|_| Vec::new());
+    let mut paired: [Vec<f64>; 9] = std::array::from_fn(|_| Vec::new());
+    let mut all: [Vec<[u64; 4]>; 2] = std::array::from_fn(|_| Vec::with_capacity(jobs * 20));
+    for batched in [false, true] {
+        assert_eq!(
+            host.block_on(batch_requests(send, texts, corpus, 1_000, callers, batched))
+                .len(),
+            1_000
+        );
+        allocation_diagnostic(host, send, texts, corpus, jobs, callers, batched);
+    }
+    for group in 0..10 {
+        let mut samples = [[0.0; 9]; 4];
+        for (position, mode) in [0, 1, 1, 0].into_iter().enumerate() {
+            let start = Instant::now();
+            let rows = host.block_on(batch_requests(
+                send,
+                texts,
+                corpus,
+                jobs,
+                callers,
+                mode == 1,
+            ));
+            let wall = start.elapsed().as_secs_f64();
+            assert_eq!(rows.len(), jobs);
+            let q = quantiles(&rows);
+            let mut record = [0.0; 9];
+            record[0] = wall;
+            for (field, value) in q.iter().enumerate() {
+                record[field + 1] = std::time::Duration::from_nanos(*value).as_secs_f64();
+            }
+            println!(
+                "UTF8-QUEUE-MATCHED-BATCH corpus={name} jobs={jobs} group={group} position={position} mode={mode} requests={jobs} errors=0 wall_ms={:.3} requests_per_second={:.3} admission_p95_ns={} admission_p99_ns={} queue_p95_ns={} queue_p99_ns={} service_p95_ns={} service_p99_ns={} response_p95_ns={} response_p99_ns={}",
+                wall * 1000.0,
+                f64::from(u32::try_from(jobs).unwrap()) / wall,
+                q[0],
+                q[1],
+                q[2],
+                q[3],
+                q[4],
+                q[5],
+                q[6],
+                q[7]
+            );
+            records[mode].push(record);
+            samples[position] = record;
+            all[mode].extend(rows);
+        }
+        for field in 0..9 {
+            paired[field].push(samples[1][field] / samples[0][field]);
+            paired[field].push(samples[2][field] / samples[3][field]);
+        }
+    }
+    for mode in 0..2 {
+        assert_eq!(records[mode].len(), 20);
+        assert_eq!(all[mode].len(), jobs * 20);
+        let q = quantiles(&all[mode]);
+        let wall_total: f64 = records[mode].iter().map(|row| row[0]).sum();
+        println!(
+            "UTF8-QUEUE-MATCHED-SUMMARY corpus={name} jobs={jobs} mode={mode} batches=20 requests={} total_wall_ms={:.3} requests_per_second={:.3} sample_capacity_bytes={} admission_p95_ns={} admission_p99_ns={} queue_p95_ns={} queue_p99_ns={} service_p95_ns={} service_p99_ns={} response_p95_ns={} response_p99_ns={}",
+            all[mode].len(),
+            wall_total * 1000.0,
+            f64::from(u32::try_from(all[mode].len()).unwrap()) / wall_total,
+            all[mode].capacity() * std::mem::size_of::<[u64; 4]>(),
+            q[0],
+            q[1],
+            q[2],
+            q[3],
+            q[4],
+            q[5],
+            q[6],
+            q[7]
+        );
+    }
+    let mut admitted = true;
+    for (field, metric) in [
+        "wall",
+        "admission_p95",
+        "admission_p99",
+        "queue_p95",
+        "queue_p99",
+        "service_p95",
+        "service_p99",
+        "response_p95",
+        "response_p99",
+    ]
+    .iter()
+    .enumerate()
+    {
+        let ratio = super::median(&paired[field]);
+        admitted &= ratio <= 1.0;
+        println!(
+            "UTF8-QUEUE-MATCHED-DECISION corpus={name} jobs={jobs} metric={metric} samples=20 paired_ratio={ratio:.6} slower={}",
+            ratio > 1.0
+        );
+    }
+    admitted
+}
+
+fn allocation_diagnostic(
+    host: &Runtime,
+    send: &mpsc::Sender<Request>,
+    texts: &Arc<Vec<String>>,
+    corpus: usize,
+    jobs: usize,
+    callers: usize,
+    reuse: bool,
+) {
+    super::allocation::start();
+    let rows = host.block_on(batch_requests(send, texts, corpus, jobs, callers, reuse));
+    drop(rows);
+    let [allocations, allocated, releases, released_bytes] = super::allocation::stop();
+    let name = SCENARIOS[corpus];
+    println!(
+        "UTF8-RESPONSE-ALLOCATION corpus={name} jobs={jobs} mode={} scope=rust_process diagnostic_only=true allocations={allocations} allocated_bytes={allocated} frees={releases} freed_bytes={released_bytes} rss_measured=false",
+        usize::from(reuse)
+    );
+}
+
+enum Response {
+    Once(oneshot::Sender<Reply>),
+    Reused(mpsc::Sender<Reply>),
+}
+struct Request {
+    corpus: usize,
+    slot: usize,
+    enqueued: Instant,
+    reply: Response,
+}
+struct Reply {
+    text: String,
+    queue_ns: u64,
+    service_ns: u64,
+}
+fn nanos(start: Instant) -> u64 {
+    u64::try_from(start.elapsed().as_nanos()).unwrap()
+}
+fn owner(mut incoming: mpsc::Receiver<Request>, ready: std_mpsc::Sender<()>) {
+    let runtime =
+        GerbilRuntime::initialize_program(gerbil_scheme_qualification::linked_program()).unwrap();
+    buffer::contracts(&runtime);
+    let roots: Vec<Vec<_>> = SCENARIOS
+        .iter()
+        .map(|name| {
+            texts_for_scenario(name)
+                .iter()
+                .map(|text| buffer::root_text(&runtime, text))
+                .collect()
+        })
+        .collect();
+    ready.send(()).unwrap();
+    drop(ready);
+    while let Some(request) = incoming.blocking_recv() {
+        let start = Instant::now();
+        let queue_ns = u64::try_from(start.duration_since(request.enqueued).as_nanos()).unwrap();
+        let text = convert(&roots[request.corpus][request.slot], 5);
+        let result = Reply {
+            text,
+            queue_ns,
+            service_ns: nanos(start),
+        };
+        match request.reply {
+            Response::Once(reply) => reply
+                .send(result)
+                .unwrap_or_else(|_| panic!("client disappeared")),
+            // One outstanding request per caller guarantees this slot is free.
+            // Never block the Scheme owner on response capacity.
+            Response::Reused(reply) => reply
+                .try_send(result)
+                .unwrap_or_else(|_| panic!("response slot unavailable")),
+        }
+    }
+    assert_eq!(runtime.add_i64(40, 2).unwrap(), 42);
+    drop(roots);
+    drop(runtime);
+}
+async fn batch_requests(
+    send: &mpsc::Sender<Request>,
+    texts: &Arc<Vec<String>>,
+    corpus: usize,
+    jobs: usize,
+    callers: usize,
+    reuse: bool,
+) -> Vec<[u64; 4]> {
+    let mut tasks = JoinSet::new();
+    for caller in 0..callers.min(jobs) {
+        let send = send.clone();
+        let texts = Arc::clone(texts);
+        tasks.spawn(async move {
+            let mut rows = Vec::with_capacity(jobs.div_ceil(callers));
+            let mut reusable = reuse.then(|| mpsc::channel(1));
+            for index in (caller..jobs).step_by(callers) {
+                let slot = index % texts.len();
+                let issued = Instant::now();
+                let (reply, wait) = if let Some((reply, _)) = &reusable {
+                    (Response::Reused(reply.clone()), None)
+                } else {
+                    let (reply, wait) = oneshot::channel();
+                    (Response::Once(reply), Some(wait))
+                };
+                let permit = send.reserve().await.expect("bounded admission");
+                let enqueued = Instant::now();
+                let admission = u64::try_from(enqueued.duration_since(issued).as_nanos()).unwrap();
+                permit.send(Request {
+                    corpus,
+                    slot,
+                    enqueued,
+                    reply,
+                });
+                let result = if let Some((_, wait)) = &mut reusable {
+                    wait.recv().await.expect("live owner")
+                } else {
+                    wait.unwrap().await.expect("live owner")
+                };
+                let response = nanos(issued);
+                assert_eq!(result.text, texts[slot]);
+                assert!(response >= admission + result.queue_ns + result.service_ns);
+                rows.push([admission, result.queue_ns, result.service_ns, response]);
+            }
+            rows
+        });
+    }
+    let mut rows = Vec::with_capacity(jobs);
+    while let Some(result) = tasks.join_next().await {
+        rows.extend(result.expect("all clients complete"));
+    }
+    rows
+}
