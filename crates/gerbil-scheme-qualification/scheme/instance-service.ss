;; Same real order computation, with independent per-lane Actor rank state.
(def orders-latch-lock (make-mutex))
(def orders-latch-event (make-condition-variable))
(def orders-latch-open #f)
(def orders-latch-blocked 0)
(def (orders-latch-wait!)
  (mutex-lock! orders-latch-lock)
  (set! orders-latch-blocked (1+ orders-latch-blocked))
  (let loop ()
    (unless orders-latch-open
      (mutex-unlock! orders-latch-lock orders-latch-event)
      (mutex-lock! orders-latch-lock)
      (loop)))
  (set! orders-latch-blocked (1- orders-latch-blocked))
  (mutex-unlock! orders-latch-lock))
(def (orders-latch-release!)
  (mutex-lock! orders-latch-lock)
  (set! orders-latch-open #t)
  (condition-variable-broadcast! orders-latch-event)
  (mutex-unlock! orders-latch-lock))
(def orders-lanes #())
(def (make-orders-lane)
  (let* ((rank (vector 0)) (lock (make-mutex))
         (next (lambda ()
                 (dynamic-wind (lambda () (mutex-lock! lock))
                   (lambda () (vector-set! rank 0 (1+ (vector-ref rank 0))) (vector-ref rank 0))
                   (lambda () (mutex-unlock! lock)))))
         (actors (make-gerbil-rs-declared-work-actor-batch (lambda (worker input)
                    (orders-handler/rank next worker input)) 4)))
    (vector actors rank)))
(def (orders-service-handler lane input)
  (if (s64vector? input)
    (call-with-gerbil-rs-service-unit
      (lambda () (if (= (s64vector-ref input 0) 11) (raise #f) (instance-native-call input))))
  ;; Explicit application tag/version [77,1] selects one native order/result layout. It is
  ;; not inferred from input length and does not enter the Actor batch barrier.
  (if (and (vector? input) (= (vector-length input) 2)
           (equal? (vector-ref input 0) (s64vector 77 1)))
    (let (order (vector-ref input 1))
      (unless (and (s64vector? order) (<= (s64vector-length order) 14))
        (error "short order exceeds four-line contract"))
      (orders-handler/rank (lambda () 1) 0 order))
    (let (state (vector-ref orders-lanes lane))
      (vector-set! (vector-ref state 1) 0 0)
      (gerbil-rs-actor-batch! (vector-ref state 0) input)))))
(def (orders-lanes-open!)
  (set! orders-lanes (make-vector 4 #f))
  (let loop ((lane 0))
    (when (< lane 4) (vector-set! orders-lanes lane (make-orders-lane)) (loop (1+ lane)))))
(def (orders-lanes-close!)
  (vector-for-each (lambda (lane) (when lane (gerbil-rs-actor-batch-close! (vector-ref lane 0)))) orders-lanes)
  (set! orders-lanes #()))
(def orders-endpoint
  (make-gerbil-rs-service-endpoint orders-service-handler 4 orders-lanes-open!
    orders-latch-release! orders-lanes-close! #t))
(def (orders-service-command command)
  (when (and (vector? command) (positive? (vector-length command))
             (s64vector? (vector-ref command 0)) (>= (s64vector-length (vector-ref command 0)) 2)
             (= (s64vector-ref (vector-ref command 0) 0) 0))
    (unless (zero? (owner-wait-trace 8 (s64vector-ref (vector-ref command 0) 1)))
      (error "qualification wake pipe identity unavailable")))
  (orders-endpoint command))
(def (orders-service-reference command)
  (case (s64vector-ref (vector-ref command 0) 0)
    ((6) (orders-service-handler 0 (vector-ref command 1)))
    ((49) (orders-service-cycle-reference command))
    ((50 51 52 53 54) (orders-actor-arrival-reference command))
    ((55 56) (orders-mailbox-backpressure command))
    ((57) (orders-mailbox-backpressure-observed command))
    ((58) (orders-mailbox-backpressure-watched command))
    ((59) (orders-mailbox-backpressure-parked command))
    ((60) (orders-mailbox-backpressure-coalesced command))
    ((61) (mailbox-ready-native-contract))
    ((62) (orders-mailbox-backpressure-scheduled command))
    ((63) (mailbox-source-plan-contract))
    ((64) (orders-mailbox-backpressure-scoped command))
    ((65) (owner-scope-vm-contract (s64vector-ref (vector-ref command 0) 1)))
    (else (error "invalid synchronous reference"))))
;; Qualification only: drive the SAME endpoint from its fixed owner. Unlike op 6,
;; this includes the service queue, Gerbil workers, waiting and ready/take custody.
;; The host must have no outstanding service requests. No lifecycle operation or
;; transferable continuation is exposed, and the production service is unchanged.
(def (orders-service-cycle-reference command)
  (let* ((header (vector-ref command 0))
         (state (orders-endpoint (vector (s64vector 15)))))
    (unless (and (= (s64vector-length header) 3)
                 (<= 0 (s64vector-ref header 1) 1)
                 (positive? (s64vector-ref header 2))
                 (zero? (s64vector-ref state 0))
                 (zero? (s64vector-ref state 3))
                 (zero? (s64vector-ref state 7)))
      (error "native cycle reference requires idle snapshot service"))
    (let* ((start (owner-wait-trace 1 0))
           (id (s64vector-ref
                 (orders-endpoint
                   (vector (s64vector 1 -1 (s64vector-ref header 1) (s64vector-ref header 2))
                           (vector-ref command 1))) 0)))
      (let loop ()
        (let (ready (orders-endpoint (vector (s64vector 3))))
          (if (positive? (s64vector-length ready))
            (begin
              (unless (and (= (s64vector-length ready) 1) (= (s64vector-ref ready 0) id))
                (error "native cycle reference observed unrelated completion"))
              (orders-endpoint (vector (s64vector 2 id))))
            (let (remaining (- 5000000000 (- (owner-wait-trace 1 0) start)))
              (unless (positive? remaining) (error "native cycle reference exceeded five seconds"))
              ;; This is the existing Scheme condition/port wait, not host polling.
              (orders-endpoint (vector (s64vector 4 (quotient (+ remaining 999) 1000))))
              (loop))))))))
;; One persistent worker exposes deterministic queue-order acceptance separately
;; from the four-VM throughput workload. It uses the identical service protocol.
(def single-started [])
(def single-accepted 0)
(def single-ready-max 0)
(def single-endpoint
  (make-gerbil-rs-service-endpoint
    (lambda (_ input)
      (call-with-gerbil-rs-service-unit
        (lambda ()
          (set! single-started (cons (s64vector-ref input 0) single-started))
          (when (= (s64vector-ref input 0) 90)
            (call-with-gerbil-rs-service-suspension orders-latch-wait!))
          (when (= (s64vector-ref input 0) 91) (raise #f))
          input)))
    1 (lambda () (set! orders-latch-open #f)) orders-latch-release! void))
(def (completion-result-count receipt)
  (let* ((size (s64vector-length receipt))
         (offset (if (and (positive? size) (= (s64vector-ref receipt 0) -8)) 2 0))
         (offset (if (and (> size offset) (= (s64vector-ref receipt offset) -6)) (+ offset 3) offset)))
    (- size offset)))
(def (single-command command)
  (let ((result (single-endpoint command)) (op (s64vector-ref (vector-ref command 0) 0)))
    (when (= op 1) (set! single-accepted (1+ single-accepted)))
    (when (= op 3) (set! single-ready-max (max single-ready-max (completion-result-count result))))
    result))
(def (orders-service-observe header)
  (case (s64vector-ref header 0)
    ((8) (orders-latch-release!) (s64vector 0))
    ((9) (set! orders-latch-open #f) (s64vector 0))
    ((24) (orders-work-contract))
    ((26) (orders-work-plan-contract))
    ((27) (orders-lease-plan-contract))
    ((28) (orders-activation-contract))
    ((29) (orders-cycle-contract))
    ((30) (orders-turn-contract))
    ((31) (orders-specialized-contract))
    ((32) (orders-reclamation-contract))
    ((33) (orders-receiver-contract))
    ((34) (orders-registration-contract))
    ((35) (orders-registration-contract 'directed))
    ((36) (orders-directed-wake-contract))
    ((37) (orders-registration-contract 'executing))
    ((38) (orders-registration-contract 'cycle-control))
    ((39) (orders-registration-contract 'ready-cycle))
    ((40) (orders-registration-contract 'progress-cycle))
    ((41) (orders-progress-cycle-contract))
    ((42) (orders-registration-contract 'runtime-control))
    ((43) (orders-registration-contract 'runtime-joint))
    ((44) (orders-runtime-contract))
    ((45) (orders-runtime-contract 'runtime-event))
    ((46) (orders-registration-contract 'runtime-event))
    ((47) (orders-registration-contract 'native-cycle))
    ((48) (orders-native-contract))
    ((16) (orders-progress-contract))
    ((13) (orders-budget-contract))
    ((14) (orders-budget-contention))
    ((15)
     (orders-endpoint (vector (s64vector 4 1000)))
     (let (start (owner-wait-trace 1 0))
       (orders-endpoint (vector (s64vector 4 1000)))
       (s64vector (- (owner-wait-trace 1 0) start))))
    ((12) (list->s64vector (append (list single-accepted single-ready-max) (reverse single-started))))
    ((17) (set! single-ready-max 0) (s64vector 0))
    ((18)
     (orders-latch-release!)
     (let loop ()
       (if (= (s64vector-ref (orders-endpoint (vector (s64vector 15))) 7) 3)
         (begin
           ;; Fresh endpoint IDs start at one. Ready is not claimed custody:
           ;; two absent epoch sentinels must never authorize a native take.
           (unless (with-catch (lambda (failure) #t)
                     (lambda () (orders-endpoint (vector (s64vector 2 1))) #f))
             (error "unclaimed ready result escaped without a token"))
           (unless (= (s64vector-ref (orders-endpoint (vector (s64vector 15))) 7) 3)
             (error "rejected take changed ready custody"))
           (s64vector 0))
         (begin (thread-yield!) (loop)))))
    ((19) (orders-completion-carry-contract))
    ((20) (orders-endpoint (vector (s64vector 15))))
    ;; Failure control: close the service with an outstanding native snapshot.
    ((21) (orders-endpoint (vector (s64vector 5))))
    ((10) (thread-yield!) (##gc) (s64vector orders-latch-blocked))
    (else (error "invalid service observation"))))
(begin-foreign
 (c-define (owner-service-call root) (int64) int64 "gerbil_owner_service_call" "extern"
  (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call root
    gerbil-scheme-rust/qualification/actors#orders-service-command)))

(begin-foreign
 (c-define (owner-service-fail root) (int64) int64 "gerbil_owner_service_fail" "extern"
  (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call root
    (lambda (command)
      (let ((result (gerbil-scheme-rust/qualification/actors#orders-service-command command)))
        (when (= (s64vector-ref (vector-ref command 0) 0) 0)
          (error "injected Scheme service initialization failure"))
        result)))))

(begin-foreign
 (c-define (owner-service-reference root) (int64) int64 "gerbil_owner_service_reference" "extern"
  (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call root
    gerbil-scheme-rust/qualification/actors#orders-service-reference))
 (c-define (owner-service-observe root) (int64) int64 "gerbil_owner_service_observe" "extern"
  (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call root
    gerbil-scheme-rust/qualification/actors#orders-service-observe)))

(begin-foreign
 (c-define (owner-service-single root) (int64) int64 "gerbil_owner_service_single" "extern"
  (gerbil-scheme-rust/scheme/runtime#gerbil-rs-rooted-call root
    gerbil-scheme-rust/qualification/actors#single-command)))

;; Contention is made deterministic while one bulk unit owns the gate. The
;; production class selector, not a test scheduler, determines subsequent grants.
(def (orders-budget-contract)
  (let ((budget (make-gerbil-rs-budget)) (events []) (parent (current-thread)))
    (gerbil-rs-budget-configure! budget 1)
    (let* ((first (spawn (lambda ()
                    (call-with-gerbil-rs-budget-context budget #f
                      (lambda () (call-with-gerbil-rs-service-unit
                        (lambda () (set! events (cons 0 events))
                          (thread-send parent 'held) (thread-receive))))))))
           (workers []))
      (thread-receive)
      (for-each
        (lambda (entry)
          (let* ((id (car entry)) (short? (cdr entry))
                 (worker (spawn (lambda ()
                           (call-with-gerbil-rs-budget-context budget short?
                             (lambda () (call-with-gerbil-rs-service-unit
                               (lambda () (set! events (cons id events))))))))))
            (set! workers (cons worker workers))
            (let wait ()
              (let (state (gerbil-rs-budget-snapshot budget))
                (unless (= (+ (s64vector-ref state 6) (s64vector-ref state 7)) (length workers))
                  (thread-yield!) (wait))))))
        (list (cons 1 #t) (cons 2 #f) (cons 3 #t)))
      (thread-send first 'release)
      (thread-join! first)
      (for-each thread-join! workers)
      (list->s64vector (append (reverse events) (s64vector->list (gerbil-rs-budget-snapshot budget)))))))


;; One directed stress control: both policies run identical real orders and an
;; explicit in-unit Scheme yield, making repeated contention observable.
(def (orders-budget-stress enabled?)
  (let ((budget (make-gerbil-rs-budget)) (verified 0) (workers []))
    (gerbil-rs-budget-configure! budget (if enabled? 1 0))
    (let launch ((worker 0))
      (when (< worker 4)
        (let (id worker)
          (set! workers (cons (spawn (lambda ()
            (call-with-gerbil-rs-budget-context budget (zero? id)
              (lambda ()
                (let loop ((index 0))
                  (when (< index 64)
                    (call-with-gerbil-rs-service-unit
                      (lambda ()
                        (thread-yield!)
                        (let (value (orders-handler/rank (lambda () 1) id
                                      (s64vector (+ (* id 64) index) 0 1 2 3)))
                          (unless (and (= (s64vector-ref value 1) 2) (= (s64vector-ref value 2) 6))
                            (error "cooperative stress order mismatch"))
                          (set! verified (1+ verified)))))
                    (loop (1+ index)))))))) workers)))
        (launch (1+ worker))))
    (for-each thread-join! workers)
    (cons verified (s64vector->list (gerbil-rs-budget-snapshot budget)))))
(def (orders-budget-contention)
  (let ((control (orders-budget-stress #f)) (candidate (orders-budget-stress #t)))
    (list->s64vector (cons (car control) candidate))))

;; A repeated unit identity across multishot continuation reentry is charged once.
(def (orders-progress-contract)
  (let* ((ledger (make-gerbil-rs-progress-ledger))
         (progress (make-gerbil-rs-progress ledger #f 2))
         (saved #f) (passes 0)
         (before (s64vector-ref (gerbil-rs-progress-receipt ledger (s64vector)) 1)))
    (parameterize ((gerbil-rs-progress-context progress))
      (call/cc (lambda (k) (set! saved k) #f))
      (gerbil-rs-progress-unit! 0)
      (set! passes (1+ passes))
      (when (= passes 1) (##gc) (saved #t)))
    (let (during (s64vector-ref (gerbil-rs-progress-receipt ledger (s64vector)) 1))
      (gerbil-rs-progress-finish! progress)
      (gerbil-rs-progress-finish! progress)
      (parameterize ((gerbil-rs-progress-context progress)) (gerbil-rs-progress-unit! 1))
      (s64vector before during (s64vector-ref (gerbil-rs-progress-receipt ledger (s64vector)) 1) passes))))

;; Exercise the actual endpoint with two ready shorts and one-ID short harvests.
;; All injected graphs are taken before returning to the Rust owner pump.
(def (orders-completion-carry-contract)
  (orders-endpoint (vector (s64vector 1 -1 1) (s64vector 0 2)))
  (orders-endpoint (vector (s64vector 1 -1 1) (s64vector 0 3)))
  (let loop ()
    (unless (= (s64vector-ref (orders-endpoint (vector (s64vector 15))) 7) 2)
      (thread-yield!) (loop)))
  (let* ((first (orders-endpoint (vector (s64vector 3))))
         (old (s64vector-ref first 1)))
    (unless (and (= (s64vector-length first) 3) (= (s64vector-ref first 0) -8))
      (error "short completion token shape"))
    (orders-endpoint (vector (s64vector 2 (s64vector-ref first 2))))
    (orders-endpoint (vector (s64vector 14 old)))
    (let* ((second (orders-endpoint (vector (s64vector 3))))
           (fresh (s64vector-ref second 1)))
      (unless (> fresh old) (error "ready carry reused consumed token epoch"))
      (orders-endpoint (vector (s64vector 2 (s64vector-ref second 2))))
      (orders-endpoint (vector (s64vector 14 old)))
      (let (state (orders-endpoint (vector (s64vector 15))))
        (unless (and (= (s64vector-ref state 2) fresh) (= (s64vector-ref state 4) 1)
                     (zero? (s64vector-ref state 3)) (zero? (s64vector-ref state 7)))
          (error "duplicate acknowledgement consumed later token")))
      (orders-endpoint (vector (s64vector 14 fresh)))))
  (s64vector 0))

;; Deterministic scheduling control: a bulk span owns the unit while a short
;; worker queues. Releasing at a safe span gives the short worker a real grant.
(def (orders-work-contract)
  (let ((budget (make-gerbil-rs-budget)) (parent (current-thread)) (stale #f))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4)
    (let (bulk (spawn (lambda ()
                (call-with-gerbil-rs-budget-context budget #f
                  (lambda () (call-with-gerbil-rs-service-unit
                    (lambda ()
                      (let (checkpoint (gerbil-rs-service-work-checkpoint))
                        (thread-send parent 'held) (thread-receive)
                        (checkpoint 4) (checkpoint 4)))))))))
      (thread-receive)
      (gerbil-rs-work-submitted! budget)
      (let (short (spawn (lambda ()
                     (gerbil-rs-work-started! budget)
                     (call-with-gerbil-rs-budget-context budget #t
                       (lambda () (call-with-gerbil-rs-service-unit
                         (lambda () ((gerbil-rs-service-work-checkpoint) 4)))))
                     (gerbil-rs-work-ready! budget))))
        (let wait ()
          (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 6) 1)
            (thread-yield!) (wait)))
        (thread-send bulk 'continue)
        (thread-join! short) (thread-join! bulk)))
    (call-with-gerbil-rs-budget-context budget #f
      (lambda ()
        (with-catch void
          (lambda () (call-with-gerbil-rs-service-unit
            (lambda () (set! stale (gerbil-rs-service-work-checkpoint)) (stale 4) (error "span failure")))))
        (let ((resume #f) (replayed #f))
          (call/cc (lambda (escape)
            (call-with-gerbil-rs-service-unit
              (lambda ()
                ((gerbil-rs-service-work-checkpoint) 4)
                (call/cc (lambda (k) (set! resume k) (escape #f)))
                ((gerbil-rs-service-work-checkpoint) 4)))))
          (unless replayed (set! replayed #t) (resume #t)))))
    (unless (gerbil-rs-budget-idle? budget) (error "work continuation leaked lease"))
    (let (receipt (gerbil-rs-work-snapshot budget))
      (gerbil-rs-work-configure! budget 0)
      (gerbil-rs-budget-configure! budget 0)
      (stale 4)
      (gerbil-rs-budget-configure! budget 1)
      (gerbil-rs-work-configure! budget 4)
      (stale 4)
      (unless (equal? (gerbil-rs-work-snapshot budget) (s64vector 4 0 0 0 0 0 0))
        (error "stale work checkpoint changed a replacement policy"))
      receipt)))

;; The parent introduces a real competing worker AFTER the bulk selected 48.
;; The selected span remains bounded; its boundary hands off before more work.
(def (orders-work-plan-contract)
  (let ((budget (make-gerbil-rs-budget)) (parent (current-thread))
        (short #f) (events []) (stale #f))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48)
    (let (bulk (spawn (lambda ()
                (call-with-gerbil-rs-budget-context budget #f
                  (lambda () (call-with-gerbil-rs-service-unit
                    (lambda ()
                      (with-gerbil-rs-service-work-plan (span charge!) 48
                        (unless (= span 48) (error "missing uncontended plan"))
                        (thread-send parent 'selected) (thread-receive)
                        (set! events (cons 1 events)) (charge! 48 #t)
                        (thread-join! short)
                        (set! events (cons 3 events)))
                      (with-gerbil-rs-service-work-plan (span charge!) 48
                        (unless (= span 4) (error "ready short did not require competitive plan"))
                        (charge! 4 #f))
                      (gerbil-rs-work-harvested! budget)
                      (with-gerbil-rs-service-work-plan (span charge!) 48
                        (unless (= span 48) (error "harvest left stale work demand"))
                        (charge! 48 #f)))))))))
      (thread-receive)
      (gerbil-rs-work-submitted! budget)
      (set! short (spawn (lambda ()
                     (gerbil-rs-work-started! budget)
                     (call-with-gerbil-rs-budget-context budget #t
                       (lambda () (call-with-gerbil-rs-service-unit
                         (lambda ()
                           (with-gerbil-rs-service-work-plan (span charge!) 4
                             (unless (= span 4) (error "invalid short plan"))
                             (set! events (cons 2 events)) (charge! 4 #f))))))
                     (gerbil-rs-work-ready! budget))))
      (let wait ()
        (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 6) 1)
          (thread-yield!) (wait)))
      (thread-send bulk 'continue) (thread-join! bulk) (thread-join! short))
    (unless (equal? (reverse events) '(1 2 3)) (error "missing short execution opportunity"))
    (call-with-gerbil-rs-budget-context budget #f
      (lambda ()
        (let ((resume #f) (replayed #f))
          (call/cc (lambda (escape)
            (call-with-gerbil-rs-service-unit
              (lambda ()
                (with-gerbil-rs-service-work-plan (span charge!) 48
                  (unless (= span 48) (error "invalid retained work plan"))
                  (set! stale (lambda () (charge! 48 #f)))
                  (charge! 48 #f)
                  (call/cc (lambda (k) (set! resume k) (escape #f)))
                  (charge! 48 #f))))))
          (unless replayed (set! replayed #t) (resume #t)))))
    (unless (gerbil-rs-budget-idle? budget) (error "plan continuation leaked lease"))
    (let ((work (gerbil-rs-work-snapshot budget)) (plans (gerbil-rs-work-plan-snapshot budget)))
      (gerbil-rs-work-configure! budget 0)
      (gerbil-rs-budget-configure! budget 0) (stale)
      (gerbil-rs-budget-configure! budget 1)
      (gerbil-rs-work-configure! budget 4 48) (stale)
      (unless (equal? (gerbil-rs-work-snapshot budget) (s64vector 4 0 0 0 0 0 0))
        (error "stale lexical plan charged a replacement"))
      (list->s64vector (append (s64vector->list work) (s64vector->list plans))))))

(include "instance-service-lease.ss")

(include "instance-service-turn.ss")

;; Deterministic service-fence ownership, without timers or scheduling guesses.
(def (orders-reclamation-contract)
  (let ((budget (make-gerbil-rs-budget)) (entered 0))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 'reclaim)
    (let ((run (lambda ()
                 (call-with-gerbil-rs-budget-context budget #f
                   (lambda () (call-with-gerbil-rs-service-unit
                     (lambda () (set! entered (1+ entered)))))))))
      (gerbil-rs-work-ready! budget)
      (let (worker (spawn run))
        (let wait ()
          (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 7) 1)
            (thread-yield!) (wait)))
        (unless (and (zero? entered) (= (s64vector-ref (gerbil-rs-work-snapshot budget) 6) 0))
          (error "unharvested short graph lost its service opportunity"))
        (gerbil-rs-work-harvested! budget)
        (thread-join! worker))
      (gerbil-rs-work-ready! budget)
      (let (worker (spawn run))
        (let wait ()
          (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 7) 1)
            (thread-yield!) (wait)))
        (gerbil-rs-work-drain! budget)
        (thread-join! worker))
      (unless (= entered 2) (error "reclamation gate failed to drain"))
      (s64vector 1 1 (if (gerbil-rs-budget-idle? budget) 1 0)))))

;; A receiver owns an opportunity only within its active Scheme service turn.
(def (orders-receiver-contract)
  (let ((budget (make-gerbil-rs-budget)) (entered 0) (worker #f))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 'receiver)
    (gerbil-rs-work-ready! budget)
    (let (run (lambda ()
               (call-with-gerbil-rs-budget-context budget #f
                 (lambda () (call-with-gerbil-rs-service-unit
                   (lambda () (set! entered (1+ entered))))))))
      ;; A pending graph alone cannot reserve a nonexistent receiver.
      (run)
      (with-catch (lambda (_) #t)
        (lambda ()
          (call-with-gerbil-rs-work-receiver budget
            (lambda ()
              (set! worker (spawn run))
              (let wait ()
                (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 7) 1)
                  (thread-yield!) (wait)))
              (unless (= entered 1) (error "active receiver lost its grant opportunity"))
              (error "injected receiver unwind without harvest")))))
      (thread-join! worker)
      (unless (and (= entered 2) (= (s64vector-ref (gerbil-rs-work-snapshot budget) 6) 0))
        (error "receiver unwind consumed ready custody"))
      (call-with-gerbil-rs-work-receiver budget
        (lambda () (gerbil-rs-work-harvested! budget)))
      (unless (= (s64vector-ref (gerbil-rs-work-snapshot budget) 6) 1)
        (error "actual receiver harvest failed to acknowledge"))
      (s64vector 1 1 (if (gerbil-rs-budget-idle? budget) 1 0)))))

;; A registered short worker retains debt until it actually receives the lease.
(def (orders-registration-contract (mode 'registered))
  (let ((budget (make-gerbil-rs-budget)) (first #f) (queued-state #f))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 mode)
    (let (new-ticket (lambda ()
                      (gerbil-rs-work-submitted! budget)
                      (let (ticket (make-gerbil-rs-work-execution budget))
                        (gerbil-rs-work-execution-runnable! ticket) ticket)))
      (set! first (new-ticket))
      (when (and (memq mode '(executing cycle-control ready-cycle progress-cycle runtime-control runtime-joint runtime-event native-cycle)) (not (gerbil-rs-work-execution-pending? budget)))
        (error "execution checkpoint lost runnable debt"))
      (unless (equal? (gerbil-rs-work-execution-snapshot budget) (s64vector 1 1 1 1 0 0 0))
        (error "runnable worker acknowledged execution"))
      (let (worker #f)
        (call-with-gerbil-rs-budget-context budget #f
          (lambda () (call-with-gerbil-rs-service-unit
            (lambda ()
              (set! worker (spawn (lambda ()
                (parameterize ((gerbil-rs-work-execution-context first))
                  (call-with-gerbil-rs-budget-context budget #t
                    (lambda () (call-with-gerbil-rs-service-unit
                      (lambda ()
                        (unless (equal? (gerbil-rs-work-execution-snapshot budget) (s64vector 1 0 1 1 1 1 0))
                          (error "actual grant did not acknowledge execution"))
                        (when (gerbil-rs-work-execution-pending? budget)
                          (error "execution checkpoint waits past first grant")) (##gc)))))))))
              (let wait ()
                (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 6) 1)
                  (thread-yield!) (wait)))
              (set! queued-state (gerbil-rs-work-execution-snapshot budget))))))
        (unless (equal? queued-state (s64vector 1 1 1 1 1 0 0))
          (error "registration acknowledged an unreceived grant"))
        (thread-join! worker))
      (gerbil-rs-work-execution-finished! first)
      ;; Multishot normal then exceptional replay takes real leases, but only
      ;; the first receiving grant settles the job's execution obligation.
      (let ((ticket (new-ticket)) (saved #f) (phase 0) (caught #f))
        (parameterize ((gerbil-rs-work-execution-context ticket))
          (call-with-gerbil-rs-budget-context budget #t
            (lambda ()
              (with-catch (lambda (_) (set! caught #t))
                (lambda ()
                  (call/cc (lambda (escape)
                    (call-with-gerbil-rs-service-unit
                      (lambda ()
                        (call/cc (lambda (k) (set! saved k) (escape #f)))
                        (when (= phase 2) (error "injected grant replay failure")) #t))))
                  (case phase
                    ((0) (set! phase 1) (saved #t))
                    ((1) (set! phase 2) (saved #t))))))))
        (unless caught (error "grant replay exception did not unwind"))
        (gerbil-rs-work-execution-finished! ticket))
      (let (ticket (new-ticket))
        (gerbil-rs-work-execution-finished! ticket)
        (gerbil-rs-work-execution-finished! ticket))
      ;; Actor workers receive the same job ticket through their native turn;
      ;; multiple actor grants must not duplicate first-execution receipts.
      (let ((ticket (new-ticket))
            (actors (make-gerbil-rs-actor-batch
                      (lambda (_ input) (call-with-gerbil-rs-service-unit (lambda () input))) 2)))
        (parameterize ((gerbil-rs-work-execution-context ticket))
          (call-with-gerbil-rs-budget-context budget #t
            (lambda () (gerbil-rs-actor-batch! actors (vector (s64vector 1) (vector 11 12))))))
        (gerbil-rs-actor-batch-close! actors)
        (gerbil-rs-work-execution-finished! ticket))
      (unless (gerbil-rs-budget-idle? budget) (error "registered protocol did not drain"))
      (gerbil-rs-work-execution-snapshot budget))))

;; Four queued acquisitions exercise FIFO within each class and the existing
;; alternating-class budget. Only the selected waiter receives a private event.
(def (orders-directed-wake-contract)
  (let ((budget (make-gerbil-rs-budget)) (threads []) (received []))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 'directed)
    (call-with-gerbil-rs-budget-context budget #f
      (lambda () (call-with-gerbil-rs-service-unit
        (lambda ()
          (for-each (lambda (entry)
            (set! threads (cons (spawn (lambda ()
              (call-with-gerbil-rs-budget-context budget (car entry)
                (lambda () (call-with-gerbil-rs-service-unit
                  (lambda ()
                    (set! received (cons (cdr entry) received))
                    (thread-yield!))))))) threads))
            ;; Register in deterministic order while this thread holds the lease.
            (let wait ()
              (let (snapshot (gerbil-rs-budget-snapshot budget))
                (unless (= (+ (s64vector-ref snapshot 6) (s64vector-ref snapshot 7))
                           (length threads))
                  (thread-yield!) (wait)))))
            (list (cons #t 1) (cons #f 2) (cons #t 3) (cons #f 4)))))))
    (for-each thread-join! threads)
    (unless (and (equal? (reverse received) '(1 2 3 4)) (gerbil-rs-budget-idle? budget))
      (error "directed grant lost, reordered or leaked"))
    (list->s64vector (reverse received))))

;; Native ready-cycle control: a suspended Scheme continuation keeps one job
;; unfinished while an exceptional result has no successful logical-work credit.
(def (orders-progress-cycle-contract)
  (def (call header (payload #f))
    (orders-endpoint (if payload (vector header payload) (vector header))))
  (def (wait-ready)
    (let loop ()
      (unless (positive? (s64vector-ref (call (s64vector 15)) 7))
        (thread-yield!) (loop))))
  (def (take-ready failed?)
    (let* ((receipt (call (s64vector 3))) (epoch (s64vector-ref receipt 1))
           (id (s64vector-ref receipt (1- (s64vector-length receipt))))
           (caught (with-catch (lambda (_) #t)
                     (lambda () (call (s64vector 2 id)) #f))))
      (unless (eq? caught failed?) (error "progress-cycle result exception mismatch"))
      (call (s64vector 14 epoch))))
  (set! orders-latch-open #f)
  (call (s64vector 1 -1) (vector (s64vector 77 1)
    (s64vector 800 2 0 1 10 1 1 20 2 1 30 3 1 40)))
  (let wait () (unless (= orders-latch-blocked 1) (thread-yield!) (wait)))
  ;; An empty boundary observes execution before the exceptional ready result.
  (call (s64vector 3))
  (call (s64vector 1 -1 1) (s64vector 11))
  (wait-ready)
  (let ((before (call (s64vector 41))) (work (call (s64vector 23))))
    (take-ready #t)
    (let (after (call (s64vector 41)))
      (unless (and (= (s64vector-ref after 8) (1+ (s64vector-ref before 8)))
                   (= (s64vector-ref after 3) (1+ (s64vector-ref before 3)))
                   (let (after-work (call (s64vector 23)))
                     (= (+ (s64vector-ref work 1) (s64vector-ref work 2))
                        (+ (s64vector-ref after-work 1) (s64vector-ref after-work 2)))))
        (error "ready retirement forged execution progress or repeated the service pass"))))
  (orders-latch-release!)
  (wait-ready) (take-ready #f)
  ;; With no unfinished jobs, an exception-only ready graph drains directly.
  (call (s64vector 1 -1 1) (s64vector 11)) (wait-ready)
  (let (before (call (s64vector 41)))
    (take-ready #t)
    (let (after (call (s64vector 41)))
      (unless (and (= (s64vector-ref before 3) (s64vector-ref after 3))
                   (= (s64vector-ref before 8) (s64vector-ref after 8)))
        (error "terminal-only ready graph caused an idle scheduling pass"))))
  (s64vector 1 1 1))

;; Actual service suspension and completion custody share no execution credit.
(def (orders-runtime-contract (mode 'runtime-joint))
  (def (call header (payload #f))
    (orders-endpoint (if payload (vector header payload) (vector header))))
  (set! orders-latch-open #f)
  (call (s64vector 1 -1) (vector (s64vector 77 1)
    (s64vector 801 2 0 1 10 1 1 20 2 1 30 3 1 40)))
  (let wait () (unless (= orders-latch-blocked 1) (thread-yield!) (wait)))
  (let ((before (call (s64vector 45))))
    (unless (and (= (s64vector-ref before 7) 1)
                 (= (+ (s64vector-ref before 2) (s64vector-ref before 3)
                       (s64vector-ref before 4) (s64vector-ref before 5)
                       (s64vector-ref before 10) (s64vector-ref before 11)) 0))
      (error "external suspension masqueraded as runnable or lease waiting"))
    (call (s64vector 3))
    (let (after (call (s64vector 45)))
      (if (= (s64vector-ref before 1) 1)
        (unless (and (= (s64vector-ref before 14) (s64vector-ref after 14))
                     (= (s64vector-ref after 15) (1+ (s64vector-ref before 15))))
          (error "external-only service did not select native wait"))
        (unless (= (s64vector-ref after 14) (1+ (s64vector-ref before 14)))
          (error "observed ready-first control changed selection")))))
  (orders-latch-release!)
  (let wait ()
    (unless (positive? (s64vector-ref (call (s64vector 15)) 7)) (thread-yield!) (wait)))
  (let* ((receipt (call (s64vector 3))) (epoch (s64vector-ref receipt 1))
         (id (s64vector-ref receipt (1- (s64vector-length receipt)))))
    (unless (= (s64vector-ref (call (s64vector 45)) 16) 1)
      (error "claimed ready graph lost completion custody"))
    (call (s64vector 2 id)) (call (s64vector 14 epoch)))
  (orders-runtime-lease-contract mode)
  (when (eq? mode 'runtime-event) (orders-runtime-fusion-contract))
  (s64vector 1 1 1))

(def (orders-runtime-lease-contract mode)
  (let ((budget (make-gerbil-rs-budget)) (parent (current-thread)))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 mode)
    (let* ((bulk (make-gerbil-rs-runtime-context budget #f))
           (short (make-gerbil-rs-runtime-context budget #t))
           (first (spawn (lambda ()
             (call-with-gerbil-rs-runtime-context bulk (lambda ()
               (call-with-gerbil-rs-budget-context budget #f (lambda ()
                 (call-with-gerbil-rs-service-unit (lambda ()
                   (let (state (gerbil-rs-runtime-snapshot budget))
                     (unless (and (= (s64vector-ref state 11) 1) (= (s64vector-ref state 3) 0))
                       (error "budget-owned direct acquisition lost cold running projection")))
                   (thread-send parent 'held) (thread-receive)))))))))))
      (thread-receive)
      (let (second (spawn (lambda ()
             (call-with-gerbil-rs-runtime-context short (lambda ()
               (call-with-gerbil-rs-budget-context budget #t (lambda ()
                 (call-with-gerbil-rs-service-unit (lambda () (##gc))))))))))
        (let wait ()
          (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 6) 1) (thread-yield!) (wait)))
        (let (state (gerbil-rs-runtime-snapshot budget))
          (unless (and (= (s64vector-ref state 4) 1) (= (s64vector-ref state 11) 1)
                       (= (s64vector-ref state 10) 0)
                       (gerbil-rs-runtime-pass? budget #f #t #f))
            (error "lease registration was not distinguished from receiving execution")))
        (thread-send first 'release) (thread-join! first) (thread-join! second)))
    (orders-runtime-epoch-contract budget mode)
    ;; Multishot entry reactivates its own context; exceptional exit retires it.
    (let ((token (make-gerbil-rs-runtime-context budget #t)) (saved #f) (phase 0) (caught #f))
      (with-catch (lambda (_) (set! caught #t))
        (lambda ()
          (call/cc (lambda (escape)
            (call-with-gerbil-rs-runtime-context token (lambda ()
              (call-with-gerbil-rs-budget-context budget #t (lambda ()
                (call-with-gerbil-rs-service-unit (lambda ()
                  (call/cc (lambda (k) (set! saved k) (escape #f)))
                  (when (= phase 2) (error "injected runtime replay failure"))))))))))
          (case phase ((0) (set! phase 1) (saved #t)) ((1) (set! phase 2) (saved #t)))))
      (unless caught (error "runtime replay exception did not unwind")))
    (let (state (gerbil-rs-runtime-snapshot budget))
      (unless (and (= (s64vector-ref state 12) (s64vector-ref state 13))
                   (let loop ((i 2)) (or (= i 12) (and (zero? (s64vector-ref state i)) (loop (1+ i))))))
        (error "runtime contexts survived terminal unwind")))))

;; A retired epoch's context cannot publish eligibility into a new budget epoch.
(def (orders-runtime-epoch-contract budget mode)
  (let (old (make-gerbil-rs-runtime-context budget #t))
    (call-with-gerbil-rs-runtime-context old void)
    (gerbil-rs-work-configure! budget 4 48 mode)
    (call-with-gerbil-rs-runtime-context old (lambda ()
      (call-with-gerbil-rs-budget-context budget #t (lambda ()
        (call-with-gerbil-rs-service-unit (lambda ()
          (let (state (gerbil-rs-runtime-snapshot budget))
            (unless (and (zero? (s64vector-ref state 12)) (zero? (s64vector-ref state 13)))
              (error "stale runtime context entered current epoch")))))))))))

;; Reenter an external suspension inside two nested budget extents. Its resume
;; must restore nesting before any work/exception suffix can release the lease.
(def (orders-runtime-fusion-contract)
  (let* ((budget (make-gerbil-rs-budget)) (layout (make-gerbil-rs-service-work-layout 4))
         (saved #f) (phase 0) (caught #f))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 'runtime-event)
    (let (token (make-gerbil-rs-runtime-context budget #f))
      (with-catch (lambda (_) (set! caught #t))
        (lambda ()
          (call/cc (lambda (escape)
            (call-with-gerbil-rs-runtime-context token (lambda ()
              (call-with-gerbil-rs-budget-context budget #f (lambda ()
                (call-with-gerbil-rs-service-unit (lambda ()
                  (call-with-gerbil-rs-service-work-layout layout (lambda (span cp)
                    (call-with-gerbil-rs-service-suspension (lambda ()
                      (let (state (gerbil-rs-runtime-snapshot budget))
                        (unless (and (= (s64vector-ref state 7) 1)
                                     (zero? (s64vector-ref state 11))
                                     (zero? (s64vector-ref (gerbil-rs-budget-snapshot budget) 8)))
                          (error "suspension and lease release were not published together")))
                      (call/cc (lambda (k) (set! saved k) (escape #f)))
                      (##gc)
                      (when (= phase 2) (error "injected exceptional suspended replay"))))
                    (let (state (gerbil-rs-runtime-snapshot budget))
                      (unless (and (= (s64vector-ref state 11) 1) (zero? (s64vector-ref state 7)))
                        (error "resume did not publish received ownership")))))
                  (unless (= (s64vector-ref (gerbil-rs-budget-snapshot budget) 8) 1)
                    (error "resume lost outer nesting ownership"))))))))))
          (case phase ((0) (set! phase 1) (saved #t)) ((1) (set! phase 2) (saved #t)))))
      (unless (and caught (= phase 2)) (error "suspended multishot exception boundary was not exercised")))
    (let (state (gerbil-rs-runtime-snapshot budget))
      (unless (and (= (s64vector-ref state 12) (s64vector-ref state 13))
                   (zero? (s64vector-ref (gerbil-rs-budget-snapshot budget) 8))
                   (let loop ((i 2)) (or (= i 12) (and (zero? (s64vector-ref state i)) (loop (1+ i))))))
        (error "fused suspension replay retained lease or runtime ownership")))))

;; The native policy must distinguish a blocked short handler from a runnable
;; one without allocating/retiring a parallel context for that job or its Actors.
(def (orders-native-contract)
  (def (call header (payload #f))
    (orders-endpoint (if payload (vector header payload) (vector header))))
  (set! orders-latch-open #f)
  (call (s64vector 1 -1 1) (vector (s64vector 77 1)
    (s64vector 811 2 0 1 10 1 1 20 2 1 30 3 1 40)))
  (let wait () (unless (= orders-latch-blocked 1) (thread-yield!) (wait)))
  (call (s64vector 1 -1) (vector (s64vector 77 1)
    (s64vector 812 0 0 1 10 1 1 20 2 1 30 3 1 40)))
  (let wait () (unless (positive? (s64vector-ref (call (s64vector 15)) 7)) (thread-yield!) (wait)))
  (let* ((before (call (s64vector 41))) (receipt (call (s64vector 3)))
         (epoch (s64vector-ref receipt 1)) (id (s64vector-ref receipt (1- (s64vector-length receipt)))))
    (unless (= (s64vector-ref before 3) (s64vector-ref (call (s64vector 41)) 3))
      (error "externally blocked short work forced an extra scheduler pass"))
    (call (s64vector 2 id)) (call (s64vector 14 epoch)))
  (orders-latch-release!)
  (let wait () (unless (positive? (s64vector-ref (call (s64vector 15)) 7)) (thread-yield!) (wait)))
  (let* ((receipt (call (s64vector 3))) (epoch (s64vector-ref receipt 1))
         (id (s64vector-ref receipt (1- (s64vector-length receipt)))))
    (call (s64vector 2 id)) (call (s64vector 14 epoch)))
  (orders-native-actor-contract)
  (s64vector 1 1 1))

(def (orders-native-actor-contract)
  (let* ((budget (make-gerbil-rs-budget)) (parent (current-thread)) (stop #f)
         (actors (make-gerbil-rs-actor-batch (lambda (worker input)
           (thread-send parent (cons worker (current-thread)))
           (thread-receive)
           (when (= worker 1) (let spin () (unless stop (thread-yield!) (spin))))
           input) 2)))
    (gerbil-rs-budget-configure! budget 1)
    (gerbil-rs-work-configure! budget 4 48 'native-cycle)
    (let (caller (spawn (lambda ()
           (call-with-gerbil-rs-budget-context budget #t (lambda ()
             (gerbil-rs-actor-batch! actors (vector (s64vector 0) (vector 1 2))))))))
      (let* ((a (thread-receive)) (b (thread-receive))
             (first (if (= (car a) 0) (cdr a) (cdr b)))
             (second (if (= (car a) 1) (cdr a) (cdr b))))
        (let wait () (when (gerbil-rs-native-source-short? budget) (thread-yield!) (wait)))
        (unless (equal? (gerbil-rs-native-snapshot budget) (s64vector 1 1))
          (error "Actor source was not registered once per epoch"))
        (thread-send second 'run)
        (thread-yield!)
        (unless (gerbil-rs-native-source-short? budget)
          (error "waiting for a Scheme processor was mistaken for external blocking"))
        (let (state (gerbil-rs-budget-snapshot budget))
          (unless (and (zero? (s64vector-ref state 6)) (zero? (s64vector-ref state 8)))
            (error "Actor readiness test accidentally relied on a budget grant")))
        (set! stop #t) (thread-send first 'finish) (thread-join! caller)))
    (when (gerbil-rs-native-source-short? budget) (error "idle Actor source remained eligible"))
    (gerbil-rs-actor-batch-close! actors)
    (unless (equal? (gerbil-rs-native-snapshot budget) (s64vector 1 0))
      (error "Actor close retained a native source"))))
